generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (darwin-arm64/linux-x64 etc.). The arm64
  // staging host runs Amazon Linux 2023, which ships OpenSSL 3.0 — the
  // CI build container's "native" detection resolved to the
  // openssl-1.1.x engine variant instead, so the deployed binary
  // couldn't load there. Explicit per the exact error Prisma raises.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Tenancy & Auth (Slice 1 / M2) ---

model Organisation {
  id     String    @id @default(cuid())
  name   String
  slug   String    @unique
  status OrgStatus @default(ACTIVE)

  /// ISO 4217 code (see src/lib/currencies.ts for the supported allowlist).
  /// The default currency for newly created financial records in this
  /// organisation — never a global hard-coded value. Configurable by
  /// OWNER/ADMIN via PATCH /organisations/me. Changing this later never
  /// mutates any existing WorkOrder/ContractorQuote's own currencyCode —
  /// each financial record stores its own, copied from this at creation.
  currencyCode String @default("AUD")

  /// ISO 3166-1 alpha-2 code (see src/lib/countries.ts for the supported
  /// allowlist). Nullable — existing organisations are never auto-assigned a
  /// jurisdiction; unset means no jurisdiction-specific feature set (see
  /// src/modules/organisations/organisation-features.ts). Independent of
  /// currencyCode: changing one must never change the other, and jurisdiction
  /// must never be inferred from currency.
  countryCode String?

  /// Set once this organisation is provisioned as a 1:1 mapped Organization in WaslSign.
  /// Nullable — provisioning happens lazily, on first need for a signed document, not at signup.
  waslSignOrganisationId String? @unique

  /// Org-level Wasl AI kill switch — OWNER/ADMIN only, via PATCH
  /// /organisations/me (see organisations.schemas.ts). Effective AI
  /// availability is this AND the platform-wide AI_ENABLED env var AND the
  /// requesting user holding the `ai.use` capability — all three, never
  /// just one (see src/modules/ai/ai.service.ts isAiAvailableForUser).
  /// Defaults false: an organisation must opt in, never silently on.
  aiEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships                      OrganisationMembership[]
  properties                       Property[]
  financialConfigurations          FinancialConfiguration[]
  financialBudgets                 FinancialBudget[]
  /// M16.2.1 — this organisation's scheme-specific chart-of-accounts rows
  /// across every property; see AccountingAccount's own doc comment on why
  /// accounts are per-property, not shared live across schemes.
  accountingAccounts               AccountingAccount[]
  /// M16.2.1 — versioned templates this organisation can provision a new
  /// scheme's chart of accounts from (copy-on-provision, never a live
  /// shared catalog — see AccountTemplate's doc comment).
  accountTemplates                 AccountTemplate[]
  accountImportBatches             AccountImportBatch[]
  /// M16.2.2 — General Ledger & Posting Engine.
  accountingPeriods                AccountingPeriod[]
  postingProfileRules              PostingProfileRule[]
  journalEntries                   JournalEntry[]
  /// M16.3 — Levy Management & UOE Allocation.
  levySchedules                    LevySchedule[]
  lotLevyCharges                   LotLevyCharge[]
  levyAdjustments                  LevyAdjustment[]
  /// M16.5 — Receipts & Payment Allocation.
  receipts                         Receipt[]
  paymentAllocations               PaymentAllocation[]
  /// M16.6 — Arrears Management.
  collectionCases                  CollectionCase[]
  collectionNotes                  CollectionNote[]
  paymentReminders                 PaymentReminder[]
  /// M16.7 — Banking & Manual Bank Reconciliation.
  bankAccounts                     BankAccount[]
  bankStatementImports             BankStatementImport[]
  bankTransactions                 BankTransaction[]
  bankTransactionMatches           BankTransactionMatch[]
  bankReconciliations              BankReconciliation[]
  /// M16.8 — Arrears Reminder Delivery & Scheduling.
  reminderPolicies                 ReminderPolicy[]
  paymentReminderDeliveryAttempts  PaymentReminderDeliveryAttempt[]
  activityEvents                   ActivityEvent[]
  maintenanceRequests              MaintenanceRequest[]
  maintenanceRequestAttachments    MaintenanceRequestAttachment[]
  contacts                         PropertyContact[]
  contactInvites                   ContactInvite[]
  sessions                         Session[]
  workOrders                       WorkOrder[]
  contractors                      Contractor[]
  contractorQuotes                 ContractorQuote[]
  communications                   Communication[]
  savedAudiences                   SavedAudience[]
  notifications                    Notification[]
  rolePermissions                  OrganisationRolePermission[]
  contractorCredentials            ContractorCredential[]
  contractorComplianceRequirements ContractorComplianceRequirement[]
  quoteRounds                      QuoteRound[]
  quoteRoundInvitations            QuoteRoundInvitation[]
  contractorQuoteAttachments       ContractorQuoteAttachment[]
  workOrderVariations              WorkOrderVariation[]
  workOrderVariationAttachments    WorkOrderVariationAttachment[]
  approvalPolicy                   OrganisationApprovalPolicy?
  approvalPolicyRules              ApprovalPolicyRule[]
  aiConversations                  AiConversation[]
  aiAuditEvents                    AiAuditEvent[]
  propertyDocuments                PropertyDocument[]
  documentAnalyses                 DocumentAnalysis[]

  @@map("organisations")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organisationMemberships               OrganisationMembership[]
  sessions                              Session[]
  propertyContacts                      PropertyContact[]
  activityEvents                        ActivityEvent[]
  maintenanceRequests                   MaintenanceRequest[]
  maintenanceRequestAttachments         MaintenanceRequestAttachment[]
  sentContactInvites                    ContactInvite[]
  createdWorkOrders                     WorkOrder[]                       @relation("WorkOrderCreatedBy")
  approvedContractorQuotes              ContractorQuote[]                 @relation("ContractorQuoteApprovedBy")
  createdCommunications                 Communication[]
  createdSavedAudiences                 SavedAudience[]
  notifications                         Notification[]
  verifiedContractorCredentials         ContractorCredential[]            @relation("ContractorCredentialVerifiedBy")
  createdContractorCredentials          ContractorCredential[]            @relation("ContractorCredentialCreatedBy")
  createdComplianceRequirements         ContractorComplianceRequirement[]
  createdQuoteRounds                    QuoteRound[]                      @relation("QuoteRoundCreatedBy")
  sentQuoteRoundInvitations             QuoteRoundInvitation[]            @relation("QuoteRoundInvitationInvitedBy")
  selectedContractorQuotes              ContractorQuote[]                 @relation("ContractorQuoteSelectedBy")
  uploadedContractorQuoteAttachments    ContractorQuoteAttachment[]
  recordedWorkOrderVariations           WorkOrderVariation[]              @relation("WorkOrderVariationRecordedBy")
  approvedWorkOrderVariations           WorkOrderVariation[]              @relation("WorkOrderVariationApprovedBy")
  uploadedWorkOrderVariationAttachments WorkOrderVariationAttachment[]
  createdApprovalPolicies               OrganisationApprovalPolicy[]      @relation("ApprovalPolicyCreatedBy")
  updatedApprovalPolicies               OrganisationApprovalPolicy[]      @relation("ApprovalPolicyUpdatedBy")
  aiConversations                       AiConversation[]
  aiAuditEvents                         AiAuditEvent[]
  uploadedPropertyDocuments             PropertyDocument[]                @relation("PropertyDocumentUploadedBy")
  confirmedPropertyDocuments            PropertyDocument[]                @relation("PropertyDocumentConfirmedBy")
  activatedFinancialConfigurations      FinancialConfiguration[]          @relation("FinancialConfigurationActivatedBy")
  createdFinancialOpeningBalances       FinancialOpeningBalance[]         @relation("FinancialOpeningBalanceCreatedBy")
  createdLotOpeningPositions            LotOpeningPosition[]              @relation("LotOpeningPositionCreatedBy")
  createdFinancialBudgets               FinancialBudget[]                 @relation("FinancialBudgetCreatedBy")
  approvedFinancialBudgets              FinancialBudget[]                 @relation("FinancialBudgetApprovedBy")
  createdAccountingAccounts             AccountingAccount[]               @relation("AccountingAccountCreatedBy")
  createdAccountTemplates               AccountTemplate[]                 @relation("AccountTemplateCreatedBy")
  appliedAccountImportBatches           AccountImportBatch[]              @relation("AccountImportBatchAppliedBy")
  closedAccountingPeriods               AccountingPeriod[]                @relation("AccountingPeriodClosedBy")
  reopenedAccountingPeriods             AccountingPeriod[]                @relation("AccountingPeriodReopenedBy")
  createdPostingProfileRules            PostingProfileRule[]              @relation("PostingProfileRuleCreatedBy")
  postedJournalEntries                  JournalEntry[]                    @relation("JournalEntryPostedBy")
  createdLevySchedules                  LevySchedule[]                    @relation("LevyScheduleCreatedBy")
  approvedLevySchedules                 LevySchedule[]                    @relation("LevyScheduleApprovedBy")
  issuedLevySchedules                   LevySchedule[]                    @relation("LevyScheduleIssuedBy")
  cancelledLevySchedules                LevySchedule[]                    @relation("LevyScheduleCancelledBy")
  reversedLevySchedules                 LevySchedule[]                    @relation("LevyScheduleReversedBy")
  issuedLevyInstallments                LevyInstallment[]                 @relation("LevyInstallmentIssuedBy")
  reversedLevyInstallments              LevyInstallment[]                 @relation("LevyInstallmentReversedBy")
  createdLevyAdjustments                LevyAdjustment[]                  @relation("LevyAdjustmentCreatedBy")
  createdReceipts                       Receipt[]                         @relation("ReceiptCreatedBy")
  reversedReceipts                      Receipt[]                         @relation("ReceiptReversedBy")
  createdPaymentAllocations             PaymentAllocation[]               @relation("PaymentAllocationCreatedBy")
  reversedPaymentAllocations            PaymentAllocation[]               @relation("PaymentAllocationReversedBy")
  assignedCollectionCases               CollectionCase[]                  @relation("CollectionCaseAssignedTo")
  openedCollectionCases                 CollectionCase[]                  @relation("CollectionCaseOpenedBy")
  closedCollectionCases                 CollectionCase[]                  @relation("CollectionCaseClosedBy")
  createdCollectionNotes                CollectionNote[]                  @relation("CollectionNoteCreatedBy")
  generatedPaymentReminders             PaymentReminder[]                 @relation("PaymentReminderGeneratedBy")
  cancelledPaymentReminders             PaymentReminder[]                 @relation("PaymentReminderCancelledBy")
  createdBankAccounts                   BankAccount[]                     @relation("BankAccountCreatedBy")
  importedBankStatements                BankStatementImport[]             @relation("BankStatementImportBy")
  confirmedBankTransactionMatches       BankTransactionMatch[]            @relation("BankTransactionMatchConfirmedBy")
  reversedBankTransactionMatches        BankTransactionMatch[]            @relation("BankTransactionMatchReversedBy")
  preparedBankReconciliations           BankReconciliation[]              @relation("BankReconciliationPreparedBy")
  reviewedBankReconciliations           BankReconciliation[]              @relation("BankReconciliationReviewedBy")
  reopenedBankReconciliations           BankReconciliation[]              @relation("BankReconciliationReopenedBy")
  updatedReminderPolicies               ReminderPolicy[]                  @relation("ReminderPolicyUpdatedBy")
  approvedPaymentReminders              PaymentReminder[]                 @relation("PaymentReminderApprovedBy")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model OrganisationMembership {
  id             String       @id @default(cuid())
  organisationId String
  userId         String
  role           OrgRole
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
  @@map("organisation_memberships")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Customer sessions only — pinned to exactly one organisation for their
/// whole lifetime — the same organisationId resolved at login/token-issue
/// time; refreshing never re-resolves a different organisation, even if the
/// user has since gained (or lost) access elsewhere — see
/// AuthService.refresh. Platform/Backoffice sessions live entirely in
/// EmployeeSession instead (see Employee below) — Session no longer serves
/// them; sessionType/PLATFORM is kept only so existing rows/migrations
/// don't need a destructive rewrite, but no new PLATFORM row is ever
/// created here.
///
/// propertyContactId pins the session to the exact relationship it was
/// issued for, not just the organisation — required once a single user can
/// hold both a staff membership and a resident contact in the *same*
/// organisation (see AuthService.listAccessOptions): null means this
/// session was issued as staff, set means it was issued as that specific
/// resident contact. Without this, refresh() would have no way to tell
/// which of the two relationships the session represents and could
/// silently resolve to the wrong one (e.g. a resident session escalating
/// to staff on refresh, since it would default to whichever access
/// resolves first).
model Session {
  id                String      @id @default(cuid())
  userId            String
  organisationId    String?
  propertyContactId String?
  sessionType       SessionType @default(CUSTOMER)
  refreshTokenHash  String
  expiresAt         DateTime
  createdAt         DateTime    @default(now())
  revokedAt         DateTime?

  user            User             @relation(fields: [userId], references: [id])
  organisation    Organisation?    @relation(fields: [organisationId], references: [id])
  propertyContact PropertyContact? @relation(fields: [propertyContactId], references: [id])

  @@index([userId])
  @@index([organisationId])
  @@index([propertyContactId])
  @@map("sessions")
}

enum SessionType {
  CUSTOMER
  PLATFORM
}

// --- Backoffice / Platform Operations (M10.5) ---

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_DEVELOPER
}

/// A WaslProperty employee — deliberately a completely separate identity
/// from User, not an extension of it: an employee has no email at all and
/// is never a customer organisation member. Employees sign in with
/// `username` only. isActive lets access be revoked without deleting the
/// grant history, and grantedByEmployeeId gives the internal-users screen
/// something real to show.
model Employee {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  firstName    String
  lastName     String
  role         PlatformRole
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  grantedByEmployeeId String?
  grantedByEmployee   Employee?  @relation("EmployeeGrantedBy", fields: [grantedByEmployeeId], references: [id])
  grantedEmployees    Employee[] @relation("EmployeeGrantedBy")

  sessions    EmployeeSession[]
  auditEvents PlatformAuditEvent[]

  @@map("employees")
}

/// The Employee-only counterpart to Session — kept as a fully separate
/// table (not a nullable-employeeId column bolted onto Session) so the two
/// identity spaces can never be conflated even at the schema level.
model EmployeeSession {
  id               String    @id @default(cuid())
  employeeId       String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("employee_sessions")
}

/// Internal audit trail for Backoffice actions — deliberately separate from
/// the customer-visible ActivityEvent model (see M10.5 design notes: reusing
/// ActivityEvent for internal platform actions would leak internal
/// operations into customer-facing timelines). Append-only from the
/// application's perspective: no update/delete endpoint is ever built for
/// this model. organisationId is nullable because many platform actions
/// (granting platform access, inspecting the Users directory) aren't scoped
/// to a single customer organisation.
model PlatformAuditEvent {
  id              String       @id @default(cuid())
  actorEmployeeId String
  platformRole    PlatformRole
  action          String
  entityType      String
  entityId        String?
  organisationId  String?
  reason          String?
  before          Json?
  after           Json?
  environment     String
  correlationId   String?
  createdAt       DateTime     @default(now())

  actorEmployee Employee @relation(fields: [actorEmployeeId], references: [id])

  @@index([actorEmployeeId])
  @@index([entityType, entityId])
  @@index([organisationId])
  @@index([createdAt])
  @@map("platform_audit_events")
}

// --- Property Foundation (Slice 1 / M3-M4) ---

model Property {
  id              String         @id @default(cuid())
  /// Short, immutable, customer-facing reference (e.g. "PROP-K7M4Q2") —
  /// see src/lib/public-reference.ts. Never the primary key, never used in
  /// FK relationships; purely the external identity shown in URLs, AI
  /// references, and operational text. Was nullable for one migration
  /// while prisma/backfill-public-references.ts filled in pre-existing
  /// rows; NOT NULL from migration 20261004092405_require_public_references
  /// onward.
  publicReference String         @unique
  organisationId  String
  name            String
  code            String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String?
  country         String
  postalCode      String?
  propertyType    PropertyType
  status          PropertyStatus @default(ACTIVE)

  /// Foundational strata metadata (M11-A) — safe to store regardless of
  /// jurisdiction, but only settable when the owning Organisation has the
  /// STRATA_MANAGEMENT feature (see organisation-features.ts); enforced in
  /// PropertiesService, not just hidden in the UI. Never used to calculate
  /// anything — no levy/fund logic reads these fields.
  isStrataManaged                      Boolean      @default(false)
  /// The scheme/strata plan registration number (e.g. an Australian "SP"
  /// number) — an identifying reference only, not validated against any
  /// jurisdiction's registry.
  strataPlanNumber                     String?
  /// Optional display name for the scheme (e.g. "Owners Corporation SP12345"),
  /// independent of Property.name.
  strataSchemeName                     String?
  /// Where this property sits in the guided "Enable Strata Management"
  /// setup flow (M11-B) — NOT_ENABLED/SETUP_IN_PROGRESS/ACTIVE. Distinct
  /// from isStrataManaged (M11-A, unchanged): isStrataManaged is a plain
  /// flag any caller can still set directly via PATCH; strataStatus is
  /// only ever advanced by StrataService's guided setup endpoints, which
  /// also set isStrataManaged=true once the scheme reaches ACTIVE (the
  /// same flag SpacesService already gates isStrataLot on). A property
  /// created before M11-B, or one only ever touched via the old raw PATCH
  /// field, simply stays NOT_ENABLED here — never inferred from
  /// isStrataManaged in reverse.
  strataStatus                         StrataStatus @default(NOT_ENABLED)
  /// The Total Units of Entitlement declared on the Strata Plan document,
  /// used only as a reconciliation target for SUM(Space.entitlementValue)
  /// across this property's strata lots (see strata.calculations.ts) —
  /// never itself the calculated total, and never read by any levy/fund
  /// logic (none exists yet). Null until recorded during setup.
  strataPlanDeclaredUnitsOfEntitlement Decimal?     @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation                    Organisation                     @relation(fields: [organisationId], references: [id])
  spaces                          Space[]
  propertyMemberships             PropertyMembership[]
  activityEvents                  ActivityEvent[]
  maintenanceRequests             MaintenanceRequest[]
  workOrders                      WorkOrder[]
  quoteRounds                     QuoteRound[]
  /// Reverse of PropertyDocument.createdPropertyId — set only for a
  /// property created via the M15 AI-assisted strata onboarding flow.
  /// Null for every property created the ordinary manual way.
  createdFromDocument             PropertyDocument?
  /// M16.1 — set only once financial setup has been started for this
  /// scheme (see FinancialConfiguration). Null, not a default row, for
  /// every property that hasn't started financial onboarding — never
  /// auto-created, never auto-activated (see migration doc comment).
  financialConfiguration          FinancialConfiguration?
  /// M16.2 — every budget (every version, every financial year) ever
  /// created for this property; never deleted, see FinancialBudget's own
  /// doc comment on why.
  financialBudgets                FinancialBudget[]
  /// M16.2.1 — this property's own scheme-specific chart of accounts; see
  /// AccountingAccount's doc comment.
  accountingAccounts              AccountingAccount[]
  accountImportBatches            AccountImportBatch[]
  /// M16.2.2 — General Ledger & Posting Engine.
  accountingPeriods               AccountingPeriod[]
  postingProfileRules             PostingProfileRule[]
  journalEntries                  JournalEntry[]
  /// M16.3 — Levy Management & UOE Allocation.
  levySchedules                   LevySchedule[]
  lotLevyCharges                  LotLevyCharge[]
  levyAdjustments                 LevyAdjustment[]
  /// M16.5 — Receipts & Payment Allocation.
  receipts                        Receipt[]
  paymentAllocations              PaymentAllocation[]
  /// M16.6 — Arrears Management.
  collectionCases                 CollectionCase[]
  collectionNotes                 CollectionNote[]
  paymentReminders                PaymentReminder[]
  /// M16.7 — Banking & Manual Bank Reconciliation.
  bankAccounts                    BankAccount[]
  bankStatementImports            BankStatementImport[]
  bankTransactions                BankTransaction[]
  bankTransactionMatches          BankTransactionMatch[]
  bankReconciliations             BankReconciliation[]
  /// M16.8 — Arrears Reminder Delivery & Scheduling.
  reminderPolicy                  ReminderPolicy?
  paymentReminderDeliveryAttempts PaymentReminderDeliveryAttempt[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("properties")
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// The guided "Enable Strata Management" setup flow's state (M11-B) — see
/// Property.strataStatus's own doc comment. No disable/deactivate
/// transition exists yet (see the M11-B requirements: no destructive
/// disabling until real financial/strata history exists to protect).
enum StrataStatus {
  NOT_ENABLED
  SETUP_IN_PROGRESS
  ACTIVE
}

/// Whether a Space in a strata-managed Property is an independent strata
/// Lot/Unit, a Common Property/Area, or not yet classified (M11-B.1). A
/// physical Space is never assumed to be a Lot just because it exists or
/// is named like one ("Lot 4" as a name proves nothing) — the Strata Plan
/// is the only source of truth for what's actually a Lot, so this is
/// always an explicit, human-made choice, never inferred. Meaningless
/// (and always UNCLASSIFIED) for a Space on a non-strata Property — see
/// SpacesService for where that's enforced. Kept in sync with the legacy
/// `isStrataLot` boolean by SpacesService/StrataService centrally (never
/// two independently-writable sources of truth) — see
/// resolveLegacySpaceClassificationTransition.
enum SpaceStrataClassification {
  UNCLASSIFIED
  LOT
  COMMON_PROPERTY
}

/// A generic leasable/occupiable unit within a property. Deliberately not
/// named "Unit" so the domain stays generic across residential, commercial,
/// retail, mixed-use, villas, parking, storage and common areas. The UI may
/// still label these "Units" for residential properties.
model Space {
  id              String      @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "LOT"
  /// prefix (covers both strata lots and non-strata spaces/units).
  publicReference String      @unique
  organisationId  String
  propertyId      String
  name            String
  code            String
  spaceType       SpaceType
  floor           String?
  sizeSqft        Int?
  status          SpaceStatus @default(VACANT)

  /// Foundational strata lot metadata (M11-A) — see Property.isStrataManaged.
  /// A space can only be marked a strata lot when its Property is itself
  /// isStrataManaged (enforced in SpacesService). Kept in sync with
  /// strataClassification (M11-B.1): true if and only if
  /// strataClassification is LOT — see SpacesService/StrataService.
  isStrataLot          Boolean                   @default(false)
  /// The strata lot/unit number, distinct from the generic `code` field
  /// used across every property type. Only meaningful when
  /// strataClassification is LOT.
  lotNumber            String?
  /// Units of Entitlement — the real, calculated figure once
  /// strataClassification is LOT (see strata.calculations.ts). Null/unused
  /// for COMMON_PROPERTY and UNCLASSIFIED spaces; never read by any
  /// calculation for those.
  entitlementValue     Decimal?                  @db.Decimal(12, 2)
  /// LOT / COMMON_PROPERTY / UNCLASSIFIED (M11-B.1) — see the enum's own
  /// doc comment. Always UNCLASSIFIED (and irrelevant) for a Space whose
  /// Property isn't strata-managed.
  strataClassification SpaceStrataClassification @default(UNCLASSIFIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id])
  memberships         PropertyMembership[]
  activityEvents      ActivityEvent[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  quoteRounds         QuoteRound[]
  /// M16.1 — set only for a Space that is a strata LOT and has had an
  /// opening financial position recorded during financial onboarding.
  /// Always null for COMMON_PROPERTY/UNCLASSIFIED spaces — see
  /// LotOpeningPosition's own doc comment for how that's enforced.
  lotOpeningPosition  LotOpeningPosition?
  /// M16.3 — every levy charge ever raised against this lot, across every
  /// schedule/installment; never deleted (see LotLevyCharge's doc comment).
  lotLevyCharges      LotLevyCharge[]
  /// M16.5 — every receipt ever recorded against this lot.
  receipts            Receipt[]
  /// M16.6 — collection workflow history for this lot.
  collectionCases     CollectionCase[]
  paymentReminders    PaymentReminder[]

  /// A strata lot number must be unique within its Property (never
  /// enforced across properties) — distinct from `code` above, which is
  /// Space's own separate general-purpose unique identifier. Prisma's
  /// schema DSL has no way to express a PARTIAL unique index (lotNumber is
  /// legitimately NULL for every non-lot Space — COMMON_PROPERTY,
  /// UNCLASSIFIED, and every space on a non-strata property — and NULLs
  /// must never collide with each other), so this is NOT declared as a
  /// Prisma `@@unique` here; it is enforced purely via a hand-written
  /// migration (see prisma/migrations/20261005100000_add_space_lot_number_unique_index)
  /// creating `CREATE UNIQUE INDEX ... WHERE "lotNumber" IS NOT NULL`. Any
  /// future schema change must not assume this constraint doesn't exist
  /// just because it isn't visible here.
  @@unique([propertyId, code])
  @@index([organisationId])
  @@index([propertyId])
  @@map("spaces")
}

enum SpaceType {
  APARTMENT
  VILLA
  OFFICE
  RETAIL
  WAREHOUSE
  PARKING
  STORAGE
  COMMON_AREA
  OTHER
}

enum SpaceStatus {
  VACANT
  OCCUPIED
  UNDER_MAINTENANCE
  RESERVED
}

// --- Strata Financial Management (M16.1) ---
//
// Establishes the trustworthy OPENING financial position of an existing
// strata scheme being migrated into WaslProp — never a general ledger, never
// levies/budgets/payments yet (see the M16.1 milestone doc). Three
// deliberate design decisions, so a future reader doesn't have to
// rediscover them from the shape of the tables alone:
//
// 1. No mutable running balance anywhere. FinancialOpeningBalance and
//    LotOpeningPosition are immutable MIGRATION records (editable only
//    while FinancialConfiguration.status is SETUP_IN_PROGRESS — enforced
//    in financials.service.ts, not here, since Prisma cannot express a
//    status-conditional write lock). Once ACTIVE, correcting one is a
//    future FinancialAdjustment (M16.2+), never an UPDATE to these rows —
//    this is the seam that avoids ever having to replace a
//    `lot.currentBalance`-style field later.
// 2. FinancialFund is long-lived (the actual Administration/Capital Works
//    "bucket" future budgets and ledger entries will post against);
//    FinancialOpeningBalance is the one-time cutover snapshot FOR that
//    fund. Keeping them as separate models (rather than balance columns
//    directly on FinancialFund) is what lets M16.2+ attach a real,
//    growing ledger to the fund without touching this milestone's tables.
// 3. amountOwing and creditBalance are separate non-negative columns, never
//    one signed number — a lot can have pre-cutover arrears and a
//    prepayment recorded independently (see the M16.1 requirements on
//    prepayments/credits never being collapsed into an ambiguous sign).

/// FinancialConfiguration.status lifecycle — mirrors StrataStatus exactly.
/// No disable/deactivate transition exists yet, same as StrataStatus: once
/// ACTIVE, there is no destructive "unlock" back to SETUP_IN_PROGRESS in
/// M16.1 (see financials.service.ts).
enum FinancialSetupStatus {
  NOT_CONFIGURED
  SETUP_IN_PROGRESS
  ACTIVE
}

/// Administration and Capital Works are the Australian strata defaults
/// (required by reconciliation before activation — see
/// financials.service.ts); OTHER covers any additional reserve/
/// special-purpose fund a scheme has, with FinancialFund.name carrying its
/// display name. Deliberately NOT two hard-coded balance columns on
/// Property — see this section's doc comment.
enum FinancialFundType {
  ADMINISTRATION
  CAPITAL_WORKS
  OTHER
}

/// One per Property, created the moment financial onboarding starts (see
/// FinancialsService.startSetup) — never auto-created for existing
/// properties by a migration (every pre-existing property simply has no
/// row here, i.e. implicitly NOT_CONFIGURED).
model FinancialConfiguration {
  id              String               @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "FIN" prefix.
  publicReference String               @unique
  organisationId  String
  propertyId      String               @unique
  status          FinancialSetupStatus @default(NOT_CONFIGURED)

  /// ISO 4217, snapshotted from Organisation.currencyCode when setup
  /// starts — never re-read live afterward (same snapshot convention as
  /// WorkOrder.currencyCode and friends), so a later organisation-wide
  /// currency change never silently reinterprets an already-recorded
  /// opening position in a different currency. Null until setup starts.
  currencyCode String?

  /// Plain accounting dates — @db.Date (no time-of-day/timezone
  /// component), never DateTime/@db.Timestamp, so serializing or reading
  /// these from a different timezone can never roll the date backward or
  /// forward a day. See financials.service.ts for the matching discipline
  /// at the API boundary (always YYYY-MM-DD strings, never a parsed JS
  /// Date compared across timezones).
  financialYearStartDate DateTime? @db.Date
  financialYearEndDate   DateTime? @db.Date
  /// "WaslProp's authoritative financial records begin from this date" —
  /// see the M16.1 requirements. Historical activity before this date is
  /// never fabricated/reconstructed; only this field marks where WaslProp's
  /// own records start.
  cutoverDate            DateTime? @db.Date

  /// Set together, exactly once, by the explicit activation action
  /// (FinancialsService.activate) — never set by any other write. Both
  /// null until then.
  activatedAt       DateTime?
  activatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation        Organisation         @relation(fields: [organisationId], references: [id])
  property            Property             @relation(fields: [propertyId], references: [id])
  activatedByUser     User?                @relation("FinancialConfigurationActivatedBy", fields: [activatedByUserId], references: [id])
  funds               FinancialFund[]
  lotPositions        LotOpeningPosition[]
  budgets             FinancialBudget[]
  /// M16.2.1 — this scheme's chart of accounts, one row per provisioned or
  /// manually-added account; see AccountingAccount's doc comment.
  accounts            AccountingAccount[]
  /// M16.2.2 — General Ledger & Posting Engine.
  accountingPeriods   AccountingPeriod[]
  postingProfileRules PostingProfileRule[]
  journalEntries      JournalEntry[]
  /// M16.3 — Levy Management & UOE Allocation.
  levySchedules       LevySchedule[]
  /// M16.5 — Receipts & Payment Allocation.
  receipts            Receipt[]
  /// M16.7 — Banking & Manual Bank Reconciliation.
  bankAccounts        BankAccount[]

  @@index([organisationId])
  @@map("financial_configurations")
}

/// The long-lived fund "bucket" itself — see this section's doc comment.
/// Duplicate Administration/Capital Works funds on the same property are
/// rejected at the service layer (FinancialsService.addFund), not via a DB
/// constraint, so OTHER funds remain freely multi-valued.
model FinancialFund {
  id                       String            @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "FUND" prefix.
  publicReference          String            @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String
  fundType                 FinancialFundType
  /// Display name — defaulted to "Administration Fund"/"Capital Works
  /// Fund" by the service layer for those two types; required, freely
  /// chosen text for OTHER (e.g. "Legal Reserve Fund").
  name                     String
  /// Snapshotted from FinancialConfiguration.currencyCode at creation —
  /// reconciliation (financials.service.ts) treats any fund whose
  /// currencyCode differs from the configuration's as an ERROR ("no
  /// unsupported currency mixing").
  currencyCode             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialConfiguration FinancialConfiguration   @relation(fields: [financialConfigurationId], references: [id])
  openingBalance         FinancialOpeningBalance?
  /// M16.2 — this fund's planned-amount lines across every budget/version
  /// ever written against it; never itself a balance (see this section's
  /// doc comment — still no mutable running total anywhere).
  budgetLines            FinancialBudgetLine[]
  /// M16.2.1 — accounts restricted to this fund only (AccountingAccount.
  /// restrictedToFundId) — see that field's doc comment on why most
  /// accounts leave this null (fund is carried on the ledger line, not the
  /// account) and only a minority (e.g. a fund's own cash account) pin to
  /// one fund.
  restrictedAccounts     AccountingAccount[]
  /// M16.2.2 — General Ledger & Posting Engine.
  postingProfileRules    PostingProfileRule[]
  journalLines           JournalLine[]
  /// M16.3 — Levy Management & UOE Allocation.
  levySchedules          LevySchedule[]
  lotLevyCharges         LotLevyCharge[]
  /// M16.5 — Receipts & Payment Allocation.
  receipts               Receipt[]
  /// M16.7 — Banking & Manual Bank Reconciliation.
  bankAccounts           BankAccount[]

  @@index([financialConfigurationId])
  @@index([propertyId])
  @@map("financial_funds")
}

/// The one-time, immutable cutover snapshot for a single fund — never a
/// mutable running balance (see this section's doc comment). Editable only
/// while FinancialConfiguration.status is SETUP_IN_PROGRESS; frozen once
/// ACTIVE.
model FinancialOpeningBalance {
  id              String   @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "FOB" prefix.
  publicReference String   @unique
  organisationId  String
  propertyId      String
  financialFundId String   @unique
  /// Must be >= 0 — validated at the Zod/service layer (no DB CHECK
  /// constraint, matching the existing entitlementValue precedent).
  amount          Decimal  @db.Decimal(12, 2)
  asOfDate        DateTime @db.Date
  currencyCode    String
  referenceNote   String?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fund          FinancialFund @relation(fields: [financialFundId], references: [id])
  createdByUser User?         @relation("FinancialOpeningBalanceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([propertyId])
  @@map("financial_opening_balances")
}

/// One per strata LOT Space that has had an opening financial position
/// recorded — never for COMMON_PROPERTY/UNCLASSIFIED (enforced in
/// financials.service.ts against Space.strataClassification, re-checked by
/// reconciliation in case a lot is reclassified after the fact). The one
/// truthful migration representation of "levies already raised before
/// cutover" (see the M16.1 requirements' Section 6.8 design decision) —
/// WaslProp never reconstructs historical levy notices it didn't issue;
/// amountOwing here IS the single migration entry for whatever was
/// genuinely still owing as of the cutover date. amountOwing and
/// creditBalance are separate non-negative columns, never one signed
/// number, so a prepayment is never ambiguous with a debt.
model LotOpeningPosition {
  id                       String   @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "LOP" prefix.
  publicReference          String   @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String
  spaceId                  String   @unique
  amountOwing              Decimal  @default(0) @db.Decimal(12, 2)
  creditBalance            Decimal  @default(0) @db.Decimal(12, 2)
  asOfDate                 DateTime @db.Date
  currencyCode             String
  referenceNote            String?
  createdByUserId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  space                  Space                  @relation(fields: [spaceId], references: [id])
  createdByUser          User?                  @relation("LotOpeningPositionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([financialConfigurationId])
  @@index([propertyId])
  @@map("lot_opening_positions")
}

// --- Strata Financial Management: Budgets (M16.2) ---
//
// Builds directly on M16.1's FinancialConfiguration/FinancialFund — a
// budget is the scheme's planned funding requirement for one financial
// year, broken down by fund (Section 2's "Financial Year -> Budget -> Fund
// -> Budget Lines" shape). Three decisions mirror M16.1's own load-bearing
// ones exactly, for the same reasons:
//
// 1. No mutable running total anywhere. FinancialBudget/FinancialBudgetLine
//    never carry a stored "totalAmount" column — totals are always summed
//    fresh from FinancialBudgetLine.plannedAmount (Decimal-safe, never a
//    JS float) by the service layer. See FinancialBudgetsService.
//
// 2. APPROVED/ACTIVE/SUPERSEDED budgets are immutable history, never
//    edited in place. A DRAFT is freely editable; once APPROVED, a
//    material change is a new FinancialBudget row (the next `version` for
//    the same propertyId + financial-year pair), never a write to the old
//    one — see FinancialBudgetsService.createRevision. SUPERSEDED exists
//    purely so the previously-ACTIVE version stays queryable for history;
//    nothing ever deletes a FinancialBudget row.
//
// 3. "Financial year" is identified by the (propertyId,
//    financialYearStartDate, financialYearEndDate) triple, not by a
//    separate FinancialYear entity — FinancialConfiguration itself only
//    ever holds one current financial year (M16.1 never modelled a
//    calendar of future years), so a budget being planned ahead of the
//    next rollover must be able to carry its own explicit dates. This also
//    means WaslProp never hard-codes an AU July-June cadence: whatever
//    dates a property's FinancialConfiguration establishes, successive
//    budgets simply carry successive non-overlapping date pairs.
//
// The one-ACTIVE-budget-per-financial-year invariant (Section 6 of the
// M16.2 requirements) is enforced THREE ways, deliberately redundant:
//   a. FinancialBudgetsService.activate locks the parent
//      FinancialConfiguration row (`SELECT ... FOR UPDATE`) before reading
//      or writing any budget for that property, serializing concurrent
//      activation attempts for the same scheme.
//   b. Within that lock, activation transactionally demotes whatever was
//      previously ACTIVE for the same financial-year pair to SUPERSEDED
//      before promoting the target budget.
//   c. A hand-written partial unique index (see the migration that adds
//      it — Prisma's schema DSL cannot express a partial index, same
//      limitation as Space.lotNumber's own unique index) makes a second
//      concurrently-committed ACTIVE row for the same (propertyId,
//      financialYearStartDate, financialYearEndDate) a database-level
//      impossibility even if (a)/(b) were ever bypassed.

/// DRAFT -> APPROVED -> ACTIVE -> SUPERSEDED, strictly forward (see
/// FinancialBudgetsService for the one legal transition out of each
/// state) — with one closure-pass exception: activating a budget also
/// walks its own `revisionOfBudgetId` chain and moves any still-APPROVED
/// ancestor (one that was approved but never itself activated, e.g. v1
/// approved then skipped straight to v2) to SUPERSEDED too, so "APPROVED"
/// never misrepresents a budget as still a live candidate once a later
/// revision in its own lineage has gone ACTIVE. An APPROVED budget
/// outside the activated one's lineage is never touched by this. Either
/// way, SUPERSEDED is terminal and permanent; there is no "reactivate"
/// path back from it — create a new revision instead.
enum FinancialBudgetStatus {
  DRAFT
  APPROVED
  ACTIVE
  SUPERSEDED
}

/// CREATED: built natively in WaslProp, start to finish (the normal path).
/// IMPORTED: a scheme's already-approved current budget, captured during
/// onboarding/migration — see FinancialBudget.externalApprovalDate's doc
/// comment for why this never fabricates a WaslProp-native approval event.
enum FinancialBudgetSource {
  CREATED
  IMPORTED
}

/// One financial year's planned funding requirement for a property, broken
/// down into FinancialBudgetLine rows grouped by FinancialFund. See this
/// section's doc comment for the three load-bearing design decisions every
/// method on FinancialBudgetsService exists to uphold.
model FinancialBudget {
  id                       String @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "BUD" prefix.
  publicReference          String @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String

  /// Plain accounting dates, same discipline as FinancialConfiguration's
  /// own financialYearStartDate/EndDate — see this section's doc comment on
  /// why these live here rather than being looked up from the
  /// configuration on every read.
  financialYearStartDate DateTime @db.Date
  financialYearEndDate   DateTime @db.Date

  /// 1, 2, 3... per (propertyId, financialYearStartDate,
  /// financialYearEndDate) group — assigned deterministically by
  /// FinancialBudgetsService.createRevision (never user-entered, never
  /// reused), with the @@unique below as the race-safety backstop: a
  /// concurrent duplicate computation collides on the constraint and
  /// retries with a freshly-read max, exactly like withPublicReference's
  /// own collision-retry pattern.
  version Int @default(1)

  status FinancialBudgetStatus @default(DRAFT)
  source FinancialBudgetSource @default(CREATED)

  /// Snapshotted from FinancialConfiguration.currencyCode at creation,
  /// same convention as FinancialFund.currencyCode — never re-read live
  /// afterward.
  currencyCode String
  notes        String?

  /// Set only when source = IMPORTED: the real-world date the scheme
  /// itself (its committee/AGM, before ever touching WaslProp) approved
  /// this budget, as attested by whoever is recording the import — NOT a
  /// claim that WaslProp witnessed that approval. approvedAt below always
  /// means "confirmed/recorded in WaslProp at this instant", for both
  /// CREATED and IMPORTED budgets; externalApprovalDate is the only field
  /// that ever represents a pre-WaslProp event, and only for IMPORTED.
  externalApprovalDate      DateTime? @db.Date
  externalApprovalReference String?

  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  /// Set once, by the one explicit activation action — never by any other
  /// write (mirrors FinancialConfiguration.activatedAt).
  activatedAt      DateTime?
  /// Set once this version is superseded by a later one reaching ACTIVE —
  /// null for every budget that has never been displaced.
  supersededAt     DateTime?

  /// Self-reference to the version this one revises — null for a
  /// property's very first budget in a given financial year. Always points
  /// to exactly the immediately-preceding version (see
  /// FinancialBudgetsService.createRevision), never an arbitrary earlier
  /// one, so the chain can be walked back one hop at a time.
  revisionOfBudgetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  createdByUser          User?                  @relation("FinancialBudgetCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUser         User?                  @relation("FinancialBudgetApprovedBy", fields: [approvedByUserId], references: [id])
  revisionOf             FinancialBudget?       @relation("FinancialBudgetRevision", fields: [revisionOfBudgetId], references: [id])
  revisions              FinancialBudget[]      @relation("FinancialBudgetRevision")
  lines                  FinancialBudgetLine[]
  /// M16.3 — regular levy schedules whose total is derived from this
  /// budget's LEVY_INCOME-linked revenue lines.
  levySchedules          LevySchedule[]

  /// Deterministic version numbering per financial-year group — see
  /// `version`'s doc comment. (The separate ONE-ACTIVE-BUDGET invariant is
  /// NOT this constraint — status isn't part of this key — see the
  /// hand-written partial unique index migration for that one.)
  @@unique([propertyId, financialYearStartDate, financialYearEndDate, version])
  @@index([organisationId])
  @@index([propertyId, status])
  @@index([financialConfigurationId])
  @@map("financial_budgets")
}

/// REVENUE | EXPENDITURE | TRANSFER | RESERVE_CONTRIBUTION | OTHER — see
/// FinancialBudgetLine.lineType's doc comment. Added in M16.2.1; every
/// pre-existing row backfills to EXPENDITURE (the default), so historical
/// expenditure totals are unchanged by this migration — see
/// FinancialBudgetsService.toView and the M16.2.1 ADR on the
/// totalBudget -> totalBudgetedRevenue/totalBudgetedExpenditure/
/// budgetedSurplusDeficit split this type makes meaningful.
enum FinancialBudgetLineType {
  REVENUE
  EXPENDITURE
  TRANSFER
  RESERVE_CONTRIBUTION
  OTHER
}

/// One category/line item within a FinancialBudget, attributed to exactly
/// one FinancialFund. `category` remains free text (never removed — see
/// below); `accountId` is the M16.2.1 addition that lets a line reference
/// the scheme's chart of accounts without forcing every historical line to
/// have one (nullable, additive — see the CoA ADR).
model FinancialBudgetLine {
  id              String @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "BUDL" prefix.
  publicReference String @unique
  organisationId  String
  propertyId      String
  budgetId        String
  financialFundId String

  /// M16.2.1 — whether this line is planned income, planned spend, an
  /// inter-fund transfer, or a reserve/capital-works contribution. Drives
  /// the funding-bridge totals in FinancialBudgetsService.toView
  /// (totalBudgetedRevenue vs totalBudgetedExpenditure); never inferred
  /// from the account's classification alone (a line can reference no
  /// account yet, same as `category` always could).
  lineType      FinancialBudgetLineType @default(EXPENDITURE)
  /// Still free text, same as before M16.2.1 — the historical label kept
  /// verbatim on every pre-existing line, and still the only categorisation
  /// available for a line with no `accountId`.
  category      String
  description   String?
  /// Must be >= 0 — a deliberately-nil line (e.g. "Legal Fees: $0 expected
  /// this year") is valid and kept, not rejected; only a negative amount
  /// is an error. Validated at the Zod/service layer, matching the
  /// existing FinancialOpeningBalance.amount precedent (no DB CHECK
  /// constraint).
  plannedAmount Decimal                 @db.Decimal(12, 2)
  notes         String?
  /// Display ordering within its fund — assigned by the service layer
  /// (append-to-end on create), editable only by reordering, never implying
  /// any business meaning beyond presentation.
  sortOrder     Int                     @default(0)
  /// M16.2.1 — optional reference into this property's chart of accounts.
  /// Nullable: every line created before M16.2.1 has none, and a manager
  /// may still add a line before the CoA is fully built out. When set, the
  /// service layer validates it belongs to the same property (never a
  /// cross-property account) — see FinancialBudgetsService.addLine.
  accountId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget  FinancialBudget    @relation(fields: [budgetId], references: [id])
  fund    FinancialFund      @relation(fields: [financialFundId], references: [id])
  account AccountingAccount? @relation(fields: [accountId], references: [id])

  @@index([budgetId])
  @@index([financialFundId])
  @@index([propertyId])
  @@index([accountId])
  @@map("financial_budget_lines")
}

// --- Strata Financial Management: Chart of Accounts (M16.2.1) ---
//
// Additive to M16.1/M16.2 — no existing financial table is rewritten.
// Three decisions mirror the rest of this section (see its own doc
// comment above FinancialConfiguration) for the same reasons:
//
// 1. Accounts are scheme-specific (one row per property), never a live
//    shared catalog across schemes — see D1 in the M16.2.1 ADR. They may
//    be provisioned from an AccountTemplate, but that template is only
//    ever COPIED at provisioning time, never read live afterward (same
//    snapshot convention as FinancialFund.currencyCode and friends).
//
// 2. An account may serve more than one fund — the fund is carried on the
//    ledger line (future M16.2.2 JournalLine), not pinned to the account —
//    see D2. `restrictedToFundId` is the deliberately narrow exception for
//    an account that genuinely belongs to one fund only (e.g. that fund's
//    own cash account), left null for every general-purpose account.
//
// 3. Deactivate, never delete. An account referenced by any
//    FinancialBudgetLine (and, from M16.2.2, any JournalLine) cannot be
//    deleted — only `isActive = false` — preserving every historical
//    reference exactly like LotOpeningPosition/FinancialOpeningBalance's
//    own "never rewrite history" discipline.

enum AccountClassification {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Property-scoped chart-of-accounts row. See this section's doc comment
/// for the three load-bearing decisions (scheme-specific, fund-flexible,
/// deactivate-not-delete) AccountsService exists to uphold.
model AccountingAccount {
  id                       String @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "ACC" prefix.
  publicReference          String @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String

  /// Unique per property (not globally) — see @@unique below. Free text,
  /// not validated against any particular numbering scheme: the CSV
  /// evidence (expense_codes_336684074.csv) shows real schemes use
  /// inconsistent numbering, and WaslProp never assumes one.
  code           String
  name           String
  description    String?
  classification AccountClassification

  /// Self-reference for a simple one-level (or deeper, if ever needed)
  /// account hierarchy — e.g. grouping several cleaning-related expense
  /// accounts under one parent for reporting. Optional; most accounts have
  /// none.
  parentAccountId    String?
  /// Null = usable against any fund (the common case — the fund is chosen
  /// per ledger line, not per account, per D2). Set only for an account
  /// that genuinely belongs to exactly one fund (e.g. that fund's own cash
  /// account) — never used to simulate a multi-fund restriction list.
  restrictedToFundId String?

  /// Deactivate, never delete (see this section's doc comment). Checked by
  /// AccountsService before every deactivate and before any reference is
  /// attached to an inactive account.
  isActive Boolean @default(true)

  /// Set only when this account was provisioned by copying an
  /// AccountTemplateLine — never re-read live from the template afterward
  /// (see this section's doc comment, point 1). Null for an account added
  /// directly or via CSV import.
  sourceTemplateLineId String?
  /// Set only when this account was created by an applied CSV import batch
  /// — informational provenance only, same spirit as
  /// ContractorQuote.source.
  sourceImportBatchId  String?
  /// Carried through from the import source row for traceability (e.g. the
  /// original "Code type" column value) — display-only, never
  /// authoritative; `classification` above is the one real field.
  externalCode         String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  parentAccount          AccountingAccount?     @relation("AccountingAccountParent", fields: [parentAccountId], references: [id])
  childAccounts          AccountingAccount[]    @relation("AccountingAccountParent")
  restrictedToFund       FinancialFund?         @relation(fields: [restrictedToFundId], references: [id])
  sourceImportBatch      AccountImportBatch?    @relation(fields: [sourceImportBatchId], references: [id])
  createdByUser          User?                  @relation("AccountingAccountCreatedBy", fields: [createdByUserId], references: [id])
  budgetLines            FinancialBudgetLine[]
  /// M16.2.2 — General Ledger & Posting Engine.
  postingProfileRules    PostingProfileRule[]
  journalLines           JournalLine[]
  /// M16.5 — every Receipt whose cash landed in this account.
  receiptsAsDestination  Receipt[]
  /// M16.7 — every BankAccount whose statement reconciles against this
  /// account.
  bankAccounts           BankAccount[]

  /// Code uniqueness is per property, not global — the same code (e.g.
  /// "150200") may legitimately exist on two different schemes.
  @@unique([propertyId, code])
  @@index([organisationId])
  @@index([propertyId])
  @@index([parentAccountId])
  @@index([restrictedToFundId])
  @@index([sourceImportBatchId])
  @@map("accounting_accounts")
}

/// Organisation-level, versioned starting point for a new scheme's chart
/// of accounts — copied, never read live (see this section's doc comment,
/// point 1). A new version never edits an older one in place, same
/// immutable-history discipline as FinancialBudget's own versioning.
model AccountTemplate {
  id              String  @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "ACCT" prefix.
  publicReference String  @unique
  organisationId  String
  name            String
  version         Int     @default(1)
  isActive        Boolean @default(true)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation  Organisation          @relation(fields: [organisationId], references: [id])
  createdByUser User?                 @relation("AccountTemplateCreatedBy", fields: [createdByUserId], references: [id])
  lines         AccountTemplateLine[]

  @@unique([organisationId, name, version])
  @@index([organisationId])
  @@map("account_templates")
}

/// One row of a template — copied verbatim into a new AccountingAccount at
/// provisioning time (code, name, classification). `parentCode` resolves
/// to a sibling line's `code` within the same template at provisioning
/// time, never a cross-template reference.
model AccountTemplateLine {
  id                String                @id @default(cuid())
  accountTemplateId String
  code              String
  name              String
  classification    AccountClassification
  parentCode        String?
  sortOrder         Int                   @default(0)

  createdAt DateTime @default(now())

  accountTemplate AccountTemplate @relation(fields: [accountTemplateId], references: [id])

  @@unique([accountTemplateId, code])
  @@index([accountTemplateId])
  @@map("account_template_lines")
}

/// One audit record per applied (never per previewed/dry-run) CSV import —
/// written only by AccountImportService.apply, inside the same transaction
/// that creates the resulting AccountingAccount rows. Per-row dry-run
/// detail is deliberately NOT persisted (see the M16.2.1 ADR on import
/// scope): a preview is a pure read computed fresh from the uploaded file
/// each time, never stored, so there is nothing stale to reconcile if the
/// scheme's accounts change between a preview and a later apply — apply
/// always re-validates against current data regardless of what an earlier
/// preview showed.
model AccountImportBatch {
  id              String   @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "IMP" prefix.
  publicReference String   @unique
  organisationId  String
  propertyId      String
  fileName        String
  totalRows       Int
  createdCount    Int
  skippedCount    Int
  appliedByUserId String
  appliedAt       DateTime @default(now())

  organisation    Organisation        @relation(fields: [organisationId], references: [id])
  property        Property            @relation(fields: [propertyId], references: [id])
  appliedByUser   User                @relation("AccountImportBatchAppliedBy", fields: [appliedByUserId], references: [id])
  createdAccounts AccountingAccount[]

  @@index([propertyId])
  @@map("account_import_batches")
}

// --- Strata Financial Management: General Ledger & Posting Engine (M16.2.2) ---
//
// Builds on M16.1 (FinancialConfiguration/FinancialFund/opening snapshots) and
// M16.2.1 (AccountingAccount) — see docs/architecture/financial-management-
// implementation-plan.md §7 and ADR-020/ADR-021 for the full design. Five
// decisions are load-bearing for every method in LedgerPostingService:
//
// 1. A JournalEntry is POSTED the instant it exists — there is no DRAFT
//    status (unlike FinancialBudget). Correction is always a new, linked
//    reversal entry; nothing posted is ever updated or deleted. This is the
//    single most important invariant in this milestone.
//
// 2. Only LedgerPostingService may create a JournalEntry/JournalLine row.
//    Every other module (levies, AP, banking — all still M16.3+) calls it
//    with a typed command; none of them touch these tables directly. This
//    file's models have no other write path by convention — enforced by
//    code review, same as every other "one service owns this table" rule
//    already in this codebase.
//
// 3. Exactly-once posting: @@unique([propertyId, sourceType, sourceId,
//    sourceEventVersion]) on JournalEntry is the same idempotency-ledger
//    pattern already proven by WaslSignWebhookEvent.eventId — a retried or
//    concurrently-duplicated posting request is a no-op returning the
//    original journal, never a second posting.
//
// 4. Money is Decimal(14,2) here, not the Decimal(12,2)/Decimal(10,2) mix
//    already in use elsewhere (FinancialBudgetLine/FinancialOpeningBalance
//    vs. WorkOrder.estimatedCost) — see the implementation plan's §1 note
//    on why ledger tables need one deliberately chosen, larger scale.
//
// 5. Fund is carried on JournalLine, not forced onto JournalEntry — a single
//    posting event (e.g. an inter-fund transfer) can legitimately touch more
//    than one fund in one balanced journal. "No silent cross-fund
//    accounting" (the safeguard from the M16.2.2 brief) is enforced in the
//    service layer: a posting command's lines are grouped by fund, and
//    LedgerPostingService rejects any command whose fund subtotals don't
//    each independently balance UNLESS the command is explicitly flagged as
//    an inter-fund transfer (sourceType = 'INTER_FUND_TRANSFER') — see
//    ledger-posting.service.ts for the exact rule.

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

/// One property's accounting-period calendar entry — posting is only ever
/// allowed into an OPEN period (see LedgerPostingService.post). Non-overlap
/// across a property's periods is validated in the service layer under the
/// same FinancialConfiguration row lock FinancialBudgetsService.activate
/// already uses, not a DB exclusion constraint (no btree_gist dependency
/// introduced for this) — see AccountingPeriodsService.
model AccountingPeriod {
  id                       String                 @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "PER" prefix.
  publicReference          String                 @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String
  startDate                DateTime               @db.Date
  endDate                  DateTime               @db.Date
  status                   AccountingPeriodStatus @default(OPEN)
  /// Set together, only by the explicit close action — never by any other
  /// write. financials.approve required (see AccountingPeriodsService).
  closedByUserId           String?
  closedAt                 DateTime?
  /// Set together, only by the explicit reopen action — a separate,
  /// equally-audited action from close, never an automatic undo.
  reopenedByUserId         String?
  reopenedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  closedByUser           User?                  @relation("AccountingPeriodClosedBy", fields: [closedByUserId], references: [id])
  reopenedByUser         User?                  @relation("AccountingPeriodReopenedBy", fields: [reopenedByUserId], references: [id])
  journalEntries         JournalEntry[]

  @@index([organisationId])
  @@index([propertyId])
  @@map("accounting_periods")
}

/// The semantic roles LedgerPostingService and OpeningJournalService
/// resolve to a concrete AccountingAccount via PostingProfileRule — never
/// hard-coded account codes anywhere in the generic posting engine (the
/// safeguard "no hardcoded Australian rules in the generic posting
/// engine" applies equally to hard-coded account identities). Deliberately
/// a fixed enum, not free text: every role here is actually consumed by
/// code in this milestone or the next (OPENING_BALANCE_EQUITY and
/// FUND_CASH/LOT_LEVY_RECEIVABLE/UNAPPLIED_CASH by OpeningJournalService
/// this milestone; LEVY_INCOME/ACCOUNTS_PAYABLE/GST_*/SUSPENSE/
/// INTER_FUND_TRANSFER reserved for M16.3+ producers that will call the
/// same LedgerPostingService).
enum PostingRole {
  FUND_CASH
  LOT_LEVY_RECEIVABLE
  LEVY_INCOME
  UNAPPLIED_CASH
  ACCOUNTS_PAYABLE
  GST_PAYABLE
  GST_RECEIVABLE
  SUSPENSE
  OPENING_BALANCE_EQUITY
  INTER_FUND_TRANSFER
}

/// One (role, fund) -> account mapping. `financialFundId = null` means the
/// rule applies regardless of fund context (e.g. a single shared
/// OPENING_BALANCE_EQUITY or SUSPENSE account) — a role scoped to a
/// specific fund (e.g. FUND_CASH for the Administration Fund vs. the
/// Capital Works Fund separately) sets it. At most one rule may exist per
/// (role, fund) pair — Postgres does not enforce this across NULL values,
/// so PostingProfileService validates it explicitly at write time (the
/// same "service-level dedup, not a DB constraint" precedent as
/// FinancialFund's own duplicate-Administration/Capital-Works rule).
/// Plain configuration metadata, not financial history — updated in
/// place, not versioned; every change is still recorded via ActivityEvent.
model PostingProfileRule {
  id                       String      @id @default(cuid())
  organisationId           String
  propertyId               String
  financialConfigurationId String
  role                     PostingRole
  financialFundId          String?
  accountId                String
  createdByUserId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  fund                   FinancialFund?         @relation(fields: [financialFundId], references: [id])
  account                AccountingAccount      @relation(fields: [accountId], references: [id])
  createdByUser          User?                  @relation("PostingProfileRuleCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organisationId])
  @@index([propertyId])
  @@index([accountId])
  @@map("posting_profile_rules")
}

/// One posted, balanced double-entry event. See this section's doc
/// comment for the five load-bearing decisions this model exists to
/// uphold — above all, POSTED the instant it exists; no DRAFT, no in-place
/// edit. `sourceType`/`sourceId`/`sourceEventVersion` identify the
/// business event that caused this posting (e.g. "MANUAL"/a generated id/1
/// for a manual journal, "OPENING_BALANCE"/financialConfigurationId/1 for
/// the opening journal — see OpeningJournalService) and are the exactly-
/// once idempotency key (see this section's doc comment, point 3).
model JournalEntry {
  id                       String @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "JRN" prefix.
  publicReference          String @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String
  accountingPeriodId       String

  /// Plain accounting date, same @db.Date/dateOnly.ts discipline as every
  /// other financial date column in this schema.
  effectiveDate DateTime @db.Date
  postedAt      DateTime @default(now())
  currencyCode  String

  sourceType         String
  sourceId           String
  /// Lets a source event repost a logically-new effect under the same
  /// sourceId without colliding with its own prior posting (mirrors
  /// FinancialBudget.version's reasoning) — almost always 1 in this
  /// milestone, since no producer other than OpeningJournalService exists
  /// yet.
  sourceEventVersion Int    @default(1)

  narration      String
  postedByUserId String

  /// Set only on a reversal entry, pointing back at the journal it
  /// reverses — unique, so a given journal can be reversed at most once
  /// (post a fresh correcting journal for anything further, never a
  /// reversal of a reversal that tries to re-net the same effect twice).
  /// Null for every ordinary posting.
  reversalOfJournalId String? @unique
  reversalReason      String?

  createdAt DateTime @default(now())

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  accountingPeriod       AccountingPeriod       @relation(fields: [accountingPeriodId], references: [id])
  postedByUser           User                   @relation("JournalEntryPostedBy", fields: [postedByUserId], references: [id])
  reversalOf             JournalEntry?          @relation("JournalEntryReversal", fields: [reversalOfJournalId], references: [id])
  /// The reversal entry that reverses THIS journal, if any — the reverse
  /// direction of `reversalOf`. Null until/unless this journal is reversed.
  reversedBy             JournalEntry?          @relation("JournalEntryReversal")
  lines                  JournalLine[]
  /// M16.3 — the schedule this journal is the issuance posting for, if any
  /// (reverse of LevySchedule.journalEntryId) — null for every other kind
  /// of journal (manual, opening balance, reversal).
  levySchedule           LevySchedule?
  /// ADR-024 — every instalment THIS journal is the issuance (or
  /// reversal) posting for. Exactly one for every journal posted going
  /// forward; more than one only for a journal that predates ADR-024 and
  /// was shared across a whole schedule's instalments (preserved by
  /// migration).
  levyInstallments       LevyInstallment[]
  /// The adjustment this journal is the correction posting for, if any.
  levyAdjustment         LevyAdjustment?
  /// M16.5 — the receipt this journal is the cash posting for, if any.
  receipt                Receipt?
  /// M16.5 — the allocation this journal is the application posting for, if any.
  paymentAllocation      PaymentAllocation?

  @@unique([propertyId, sourceType, sourceId, sourceEventVersion])
  @@index([organisationId])
  @@index([propertyId])
  @@index([accountingPeriodId])
  @@map("journal_entries")
}

/// One debit-or-credit side of a JournalEntry. Exactly one of debit/credit
/// is non-zero per row (validated in LedgerPostingService, not a DB CHECK
/// constraint — same precedent as every other Decimal invariant in this
/// schema); SUM(debit) = SUM(credit) across every line of one
/// JournalEntry is the core double-entry invariant, also enforced in the
/// service layer at posting time inside the same transaction that writes
/// these rows.
model JournalLine {
  id              String  @id @default(cuid())
  journalEntryId  String
  organisationId  String
  propertyId      String
  accountId       String
  financialFundId String
  debit           Decimal @default(0) @db.Decimal(14, 2)
  credit          Decimal @default(0) @db.Decimal(14, 2)
  lineNarration   String?
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())

  journalEntry           JournalEntry           @relation(fields: [journalEntryId], references: [id])
  account                AccountingAccount      @relation(fields: [accountId], references: [id])
  fund                   FinancialFund          @relation(fields: [financialFundId], references: [id])
  /// M16.7 — set when a bank transaction was matched to this specific
  /// existing GL cash movement (an outgoing payment, bank charge, etc.).
  bankTransactionMatches BankTransactionMatch[]

  @@index([journalEntryId])
  @@index([accountId])
  @@index([financialFundId])
  @@index([propertyId])
  @@map("journal_lines")
}

// --- Strata Financial Management: Levy Management & UOE Allocation (M16.3) ---
//
// Builds on M16.2.2's posting contract (LedgerPostingService) — no new ledger
// table, every levy posts through the existing JournalEntry/JournalLine via
// LedgerPostingService.postWithinTransaction. Load-bearing decisions (see
// docs/architecture/adr/ADR-022, ADR-023, ADR-024):
//
// 1. One fund per schedule. A scheme's Administrative and Capital Works
//    levies are always separate LevySchedule rows, matching standard
//    Australian strata practice and keeping every schedule's own posting
//    trivially fund-balanced (same "tag both lines of a pair with the same
//    fund" discipline OpeningJournalService already established).
//
// 2. One posted JournalEntry per INSTALMENT issuance (ADR-024, replacing
//    this milestone's original "one aggregated journal per whole-schedule
//    issuance" design) — one DEBIT LOT_LEVY_RECEIVABLE + one CREDIT
//    LEVY_INCOME line per fund, posted when that specific instalment is
//    struck, not when the schedule is approved. This matches NSW Strata
//    Schemes Management Act 2015 s.81/s.85 practice: a scheme's annual
//    contribution is determined once, but each instalment is separately
//    levied (and separately due, separately interest-bearing on arrears)
//    at its own date — never all struck simultaneously regardless of how
//    far in the future they fall. LotLevyCharge rows for an instalment are
//    created only when THAT instalment is issued. SUM(LotLevyCharge.amount)
//    for an instalment reconciles exactly to its own receivable line
//    (FIN-013); SUM across a schedule's issued instalments reconciles to
//    the schedule's totalAmount only once every instalment is issued.
//    LevySchedule.journalEntryId/issuedAt/issuedByUserId are now populated
//    only for schedules that were fully issued under the pre-ADR-024
//    whole-schedule model (preserved by migration, never rewritten) — a
//    schedule issued under this model instead carries that detail per
//    LevyInstallment.
//
// 3. Issued is immutable, now at the instalment level. LotLevyCharge.amount
//    is never edited after issuance; a correction is either a
//    LevyAdjustment (a small posted delta against one charge) or reversing
//    that ONE instalment's own journal via
//    LedgerPostingService.reverseWithinTransaction (LevyInstallment.status
//    -> REVERSED) — never a direct UPDATE on a charge row, and never a
//    whole-schedule reversal (there is no longer one journal to reverse at
//    that level — see LevySchedule.status's PARTIALLY_ISSUED/ISSUED notes).

enum LevyKind {
  REGULAR
  SPECIAL
}

/// Schedule-level status now derives from its instalments' own statuses
/// (ADR-024) rather than being independently set by a whole-schedule
/// issue/reverse action — LevyService recomputes it after every
/// instalment-level change.
enum LevyScheduleStatus {
  DRAFT
  APPROVED
  /// At least one instalment ISSUED, at least one still PENDING.
  PARTIALLY_ISSUED
  /// Every instalment ISSUED (none PENDING, none REVERSED-and-not-reissued
  /// — a REVERSED instalment with no later reissue drops the schedule back
  /// to PARTIALLY_ISSUED or APPROVED, never leaves it at ISSUED).
  ISSUED
  /// Cancelled before any instalment was ever issued — nothing was posted,
  /// so this is a simple terminal state, not a reversal. Blocked once any
  /// instalment has ever been issued, even if later reversed (real
  /// financial history exists by then).
  CANCELLED
  /// Pre-ADR-024 legacy terminal state: a schedule fully reversed under
  /// the old whole-schedule model (LevySchedule.journalEntryId/
  /// reversedAt/reversedByUserId/reversalReason set). No schedule reaches
  /// this status going forward — reversal is per-instalment now, so a
  /// schedule's status instead moves back to PARTIALLY_ISSUED/APPROVED.
  REVERSED
}

enum LevyChargeStatus {
  /// The only status this milestone ever sets. PART_PAID/PAID/OVERDUE are
  /// modelled now so M16.4 (receipts) can drive them without a schema
  /// change, but nothing in M16.3 ever sets them.
  ISSUED
  PART_PAID
  PAID
  OVERDUE
  /// Set only when the owning INSTALMENT is reversed (ADR-024) — the
  /// charge itself is never deleted (see this section's doc comment,
  /// point 3).
  CANCELLED
}

/// ADR-024 — the instalment, not the schedule, is now the real issuance
/// unit. See LevyInstallment.
enum LevyInstallmentStatus {
  PENDING
  ISSUED
  /// Reversed via LedgerPostingService.reverseWithinTransaction — the
  /// original posting and every LotLevyCharge for this instalment stay
  /// exactly as issued; only this status and the linked reversal journal
  /// record the correction. Terminal — same "never a reversal of a
  /// reversal" discipline as JournalEntry.reversalOfJournalId; a further
  /// correction is a LevyAdjustment or a fresh special levy, never
  /// re-issuing this instalment.
  REVERSED
}

/// One levy assessment for one fund — the unit of approval and issuance.
/// See this section's doc comment for why it's always single-fund and why
/// issuance posts one aggregated journal rather than one line per lot.
model LevySchedule {
  id                       String             @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "LEVY" prefix.
  publicReference          String             @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String
  financialFundId          String
  /// Required for REGULAR (the schedule's total is derived from this
  /// budget's own LEVY_INCOME-linked revenue lines — see
  /// LevyService.deriveRegularTotal); always null for SPECIAL.
  financialBudgetId        String?
  kind                     LevyKind
  name                     String
  /// SUM of every installment's amount — validated exactly equal at
  /// creation (see LevyInstallment.amount), never independently entered.
  totalAmount              Decimal            @db.Decimal(14, 2)
  status                   LevyScheduleStatus @default(DRAFT)

  /// Required for SPECIAL — the real-world committee/AGM resolution this
  /// levy was raised under, never fabricated by WaslProp. Same
  /// non-fabrication discipline as FinancialBudget.externalApprovalDate.
  rationale                 String?
  externalApprovalDate      DateTime? @db.Date
  externalApprovalReference String?

  createdByUserId   String?
  approvedByUserId  String?
  approvedAt        DateTime?
  /// ADR-024: these five fields (issuedByUserId/issuedAt/journalEntryId/
  /// reversedByUserId/reversedAt/reversalReason, plus status REVERSED) are
  /// now written only by the migration that backfilled pre-ADR-024
  /// whole-schedule issuances — a schedule issued going forward carries
  /// this detail per LevyInstallment instead, since each instalment posts
  /// (and may be reversed) independently. Left in place, never rewritten,
  /// so a schedule issued under the old model keeps its original history
  /// exactly as it happened.
  issuedByUserId    String?
  issuedAt          DateTime?
  journalEntryId    String?   @unique
  cancelledByUserId String?
  cancelledAt       DateTime?
  cancelReason      String?
  reversedByUserId  String?
  reversedAt        DateTime?
  reversalReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  fund                   FinancialFund          @relation(fields: [financialFundId], references: [id])
  budget                 FinancialBudget?       @relation(fields: [financialBudgetId], references: [id])
  createdByUser          User?                  @relation("LevyScheduleCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUser         User?                  @relation("LevyScheduleApprovedBy", fields: [approvedByUserId], references: [id])
  issuedByUser           User?                  @relation("LevyScheduleIssuedBy", fields: [issuedByUserId], references: [id])
  cancelledByUser        User?                  @relation("LevyScheduleCancelledBy", fields: [cancelledByUserId], references: [id])
  reversedByUser         User?                  @relation("LevyScheduleReversedBy", fields: [reversedByUserId], references: [id])
  journalEntry           JournalEntry?          @relation(fields: [journalEntryId], references: [id])
  installments           LevyInstallment[]
  charges                LotLevyCharge[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([financialFundId])
  @@index([financialBudgetId])
  @@map("levy_schedules")
}

/// One due date under a schedule. `amount` is explicit, caller-supplied
/// input (never auto-derived by an equal-split policy this milestone
/// doesn't invent — see ADR-022) — validated to sum exactly to the
/// schedule's totalAmount.
model LevyInstallment {
  id             String                @id @default(cuid())
  levyScheduleId String
  dueDate        DateTime              @db.Date
  amount         Decimal               @db.Decimal(14, 2)
  sortOrder      Int                   @default(0)
  /// ADR-024 — this instalment's own issuance state, independent of its
  /// siblings. See LevyInstallmentStatus.
  status         LevyInstallmentStatus @default(PENDING)

  issuedByUserId   String?
  issuedAt         DateTime?
  /// The one JournalEntry THIS instalment's issuance produced — null until
  /// ISSUED. Deliberately NOT @unique: every instalment issued under
  /// ADR-024 gets its own distinct journal (so uniqueness holds in
  /// practice going forward), but the migration that introduced this
  /// column backfilled every instalment of a pre-ADR-024 whole-schedule
  /// issuance with that SAME shared journal — accurately reflecting that
  /// they really were posted together as one journal, which a unique
  /// constraint would reject.
  journalEntryId   String?
  reversedByUserId String?
  reversedAt       DateTime?
  reversalReason   String?

  createdAt DateTime @default(now())

  levySchedule   LevySchedule    @relation(fields: [levyScheduleId], references: [id])
  issuedByUser   User?           @relation("LevyInstallmentIssuedBy", fields: [issuedByUserId], references: [id])
  reversedByUser User?           @relation("LevyInstallmentReversedBy", fields: [reversedByUserId], references: [id])
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  charges        LotLevyCharge[]

  @@index([levyScheduleId])
  @@index([journalEntryId])
  @@map("levy_installments")
}

/// One lot's charge for one installment — the real per-lot subledger
/// (FIN-013). `amount` is immutable once created (issuance is the only
/// writer, never edited — see this section's doc comment, point 3).
/// `status` is the one mutable field, written by two independent
/// mechanisms that never conflict: reversal (ADR-024, -> CANCELLED,
/// terminal) and, from M16.5, PaymentAllocation applying/unwinding against
/// this charge (-> PART_PAID/PAID and back, never touching a CANCELLED
/// charge — see ReceiptsService). This is exactly what ADR-024's own
/// LevyChargeStatus doc comment anticipated ("modelled now so M16.4
/// (receipts) can drive them without a schema change").
model LotLevyCharge {
  id                String           @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "LVC" prefix.
  publicReference   String           @unique
  organisationId    String
  propertyId        String
  levyScheduleId    String
  levyInstallmentId String
  spaceId           String
  financialFundId   String
  amount            Decimal          @db.Decimal(14, 2)
  status            LevyChargeStatus @default(ISSUED)

  createdAt DateTime @default(now())

  levySchedule    LevySchedule        @relation(fields: [levyScheduleId], references: [id])
  levyInstallment LevyInstallment     @relation(fields: [levyInstallmentId], references: [id])
  space           Space               @relation(fields: [spaceId], references: [id])
  fund            FinancialFund       @relation(fields: [financialFundId], references: [id])
  adjustments     LevyAdjustment[]
  /// M16.5 — every PaymentAllocation ever applied against this charge
  /// (including later-reversed ones, never deleted).
  allocations     PaymentAllocation[]
  organisation    Organisation        @relation(fields: [organisationId], references: [id])
  property        Property            @relation(fields: [propertyId], references: [id])

  @@index([organisationId])
  @@index([propertyId])
  @@index([levyScheduleId])
  @@index([levyInstallmentId])
  @@index([spaceId])
  @@map("lot_levy_charges")
}

/// A controlled correction to one lot's charge, posted as its own small
/// journal — never a direct edit of LotLevyCharge.amount. The charge's
/// effective amount is always `amount + SUM(adjustments.amount)`, derived
/// fresh, never stored.
model LevyAdjustment {
  id              String  @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "LVA" prefix.
  publicReference String  @unique
  organisationId  String
  propertyId      String
  lotLevyChargeId String
  /// Signed — positive increases the lot's receivable, negative reduces
  /// it (e.g. an entitlement-data correction or a documented waiver).
  amount          Decimal @db.Decimal(14, 2)
  reason          String
  journalEntryId  String  @unique

  createdByUserId String
  createdAt       DateTime @default(now())

  lotLevyCharge LotLevyCharge @relation(fields: [lotLevyChargeId], references: [id])
  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id])
  createdByUser User          @relation("LevyAdjustmentCreatedBy", fields: [createdByUserId], references: [id])
  organisation  Organisation  @relation(fields: [organisationId], references: [id])
  property      Property      @relation(fields: [propertyId], references: [id])

  @@index([lotLevyChargeId])
  @@index([propertyId])
  @@map("levy_adjustments")
}

// --- Strata Financial Management: Receipts & Payment Allocation (M16.5) ---
//
// Extends the existing General Ledger and Lot Ledger — never a second
// accounting system. Two models, mirroring the real-world distinction
// between a cash EVENT and its APPLICATION:
//
// 1. Receipt — "money arrived." Always posts exactly ONE journal at
//    creation time, unconditionally: Dr FUND_CASH / Cr UNAPPLIED_CASH (the
//    PostingRole M16.1 already modelled for exactly this, unused until
//    now). This is the ONLY way cash enters the books from a receipt —
//    recording a receipt is itself a posted ledger event, not a draft, so
//    it requires financials.approve like issue()/reverseInstallment() do.
//    A receipt with zero allocations against it IS an unapplied credit /
//    advance payment — no separate model for that state; it is simply
//    what an un-allocated Receipt already means.
//
// 2. PaymentAllocation — "this part of that money was applied to this
//    specific receivable." Posts its own journal: Dr UNAPPLIED_CASH / Cr
//    LOT_LEVY_RECEIVABLE, for the allocation's own amount only — never
//    combined with the Receipt's own cash posting into one journal, even
//    when allocated immediately at receipt time, so the two real events
//    stay independently traceable and independently reversible.
//
// Never a single "amount paid" column anywhere, and never an editable
// running balance — the lot's net balance is always derived fresh by
// LotLedgerService from these rows plus LotLevyCharge/LevyAdjustment/
// LotOpeningPosition, exactly as M16.4 established (ADR-025). Cross-fund
// allocation (a receipt posted into one fund's cash account, allocated
// against another fund's receivable) is deliberately NOT supported here —
// ReceiptsService rejects it outright rather than silently netting across
// funds (ADR-020) or inventing an inter-fund-transfer leg this milestone
// didn't design; see ADR-026.

/// How a receipt arrived. A fixed enum, not an organisation-configurable
/// list — M16.5 does not build settings UI for custom payment methods;
/// OTHER covers anything the fixed list doesn't name.
enum ReceiptPaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

/// RECORDED -> REVERSED, terminal (mirrors LevyInstallmentStatus's own
/// discipline). A Receipt with any still-APPLIED PaymentAllocation cannot
/// be reversed directly — every allocation against it must be reversed
/// first (see ReceiptsService.reverseReceipt).
enum ReceiptStatus {
  RECORDED
  REVERSED
}

/// APPLIED -> REVERSED, terminal. Reversing an allocation never edits
/// `amount`; it posts the exact opposite journal and flips this status,
/// the same "reversal is its own row, never a mutation" discipline as
/// LevyInstallment/LotLevyCharge.
enum PaymentAllocationStatus {
  APPLIED
  REVERSED
}

/// A recorded cash receipt — see this section's doc comment for why this
/// always posts Dr FUND_CASH / Cr UNAPPLIED_CASH unconditionally, whether
/// or not it is allocated to anything yet. Never claims bank
/// reconciliation — there is no `reconciledAt`/`reconciled` field on this
/// model at all; that is M16.7's own concern (FIN-018/019), deliberately
/// out of scope here (see ADR-026).
model Receipt {
  id                       String               @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "RCT" prefix.
  publicReference          String               @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String
  /// The lot this receipt is recorded against — required; M16.5 only
  /// supports lot-scoped receipts (every demo scenario and every Lot
  /// Ledger integration point is lot-level). A property-level receipt
  /// with no lot is not built this milestone.
  spaceId                  String
  /// The fund whose FUND_CASH account actually received this money —
  /// fixed at creation, never changed. An allocation against a charge in
  /// a DIFFERENT fund is rejected (see this section's doc comment).
  financialFundId          String
  /// The resolved FUND_CASH account for `financialFundId` at the time of
  /// recording — snapshotted, not re-resolved later, same discipline as
  /// every other posting-profile-resolved accountId already stored on a
  /// posted record in this schema.
  destinationAccountId     String
  amount                   Decimal              @db.Decimal(14, 2)
  currencyCode             String
  paymentMethod            ReceiptPaymentMethod
  paymentReference         String?
  description              String?
  /// When the money actually arrived — distinct from `postingDate`,
  /// which is the accounting date the journal is posted against (must
  /// fall in an OPEN AccountingPeriod; `receiptDate` has no such
  /// constraint, since a bank transfer can arrive on a weekend/holiday
  /// the books post on the next open day).
  receiptDate              DateTime             @db.Date
  postingDate              DateTime             @db.Date
  /// Optional reference to the bank's own transaction record — never
  /// used to assert reconciliation by itself (see this model's own doc
  /// comment); purely a human cross-reference for M16.7 to consume later.
  externalBankReference    String?
  status                   ReceiptStatus        @default(RECORDED)
  /// The one journal this receipt's cash posting produced — set exactly
  /// once at creation, never re-pointed.
  journalEntryId           String               @unique
  reversedByUserId         String?
  reversedAt               DateTime?
  reversalReason           String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  space                  Space                  @relation(fields: [spaceId], references: [id])
  fund                   FinancialFund          @relation(fields: [financialFundId], references: [id])
  destinationAccount     AccountingAccount      @relation(fields: [destinationAccountId], references: [id])
  journalEntry           JournalEntry           @relation(fields: [journalEntryId], references: [id])
  createdByUser          User                   @relation("ReceiptCreatedBy", fields: [createdByUserId], references: [id])
  reversedByUser         User?                  @relation("ReceiptReversedBy", fields: [reversedByUserId], references: [id])
  allocations            PaymentAllocation[]
  /// M16.7 — set when a bank transaction was matched (or, for
  /// NEW_RECEIPT, caused the creation of) this receipt.
  bankTransactionMatches BankTransactionMatch[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([spaceId])
  @@index([financialFundId])
  @@map("receipts")
}

/// One application of (part of) a Receipt against one LotLevyCharge — see
/// this section's doc comment for the Dr UNAPPLIED_CASH / Cr
/// LOT_LEVY_RECEIVABLE posting this produces. `amount` is immutable;
/// `effectiveAmount` is not a stored concept here the way LevyAdjustment
/// has one — a REVERSED allocation simply no longer counts toward the
/// charge's paid total (see LotLedgerService), the charge row is never
/// re-summed in place.
model PaymentAllocation {
  id              String                  @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "PALLOC" prefix.
  publicReference String                  @unique
  organisationId  String
  propertyId      String
  receiptId       String
  lotLevyChargeId String
  amount          Decimal                 @db.Decimal(14, 2)
  status          PaymentAllocationStatus @default(APPLIED)
  /// The journal this allocation's own posting produced — set once, never
  /// re-pointed. Null only on a row created purely as a historical
  /// reversal record is never the case here — every row always has one,
  /// since even the reversal flips THIS row's status rather than creating
  /// a new row (mirrors LevyInstallment's reversal-in-place-status
  /// pattern, not LotLevyCharge's separate-reversal-row pattern, because
  /// an allocation has no sibling rows another reversal could be confused
  /// with).
  journalEntryId  String                  @unique

  reversedByUserId String?
  reversedAt       DateTime?
  reversalReason   String?

  createdByUserId String
  createdAt       DateTime @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  property       Property      @relation(fields: [propertyId], references: [id])
  receipt        Receipt       @relation(fields: [receiptId], references: [id])
  lotLevyCharge  LotLevyCharge @relation(fields: [lotLevyChargeId], references: [id])
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
  createdByUser  User          @relation("PaymentAllocationCreatedBy", fields: [createdByUserId], references: [id])
  reversedByUser User?         @relation("PaymentAllocationReversedBy", fields: [reversedByUserId], references: [id])

  @@index([organisationId])
  @@index([propertyId])
  @@index([receiptId])
  @@index([lotLevyChargeId])
  @@map("payment_allocations")
}

// --- Strata Financial Management: Arrears Management (M16.6, ADR-027) ---
//
// No new financial-truth table. Every overdue amount, ageing bucket and
// total is computed live from LotLevyCharge/LevyAdjustment/PaymentAllocation/
// LevyInstallment/Receipt — the three models below hold ONLY the manual
// collection workflow layered on top (status, notes, draft reminders),
// never a cached financial balance. See ADR-027 for the full decision
// record, including why LotLevyCharge's own reserved OVERDUE status value
// stays permanently unused.

enum CollectionCaseStatus {
  OPEN
  IN_PROGRESS
  AWAITING_PAYMENT
  ESCALATED
  RESOLVED
  CLOSED
  /// M16.8 — the owner has disputed this debt; automated reminder
  /// eligibility (ReminderEligibilityService) suppresses this lot while
  /// a case sits in this status. Set/cleared via the existing
  /// updateCollectionCase action — no new endpoint.
  DISPUTED
  /// M16.8 — collection activity (including automated reminders) is on
  /// hold for this case — e.g. a manager-agreed pause pending a
  /// documented payment arrangement. This schema has no separate
  /// PaymentArrangement model; AWAITING_PAYMENT already carries that
  /// semantic for an in-progress arrangement and is treated the same way
  /// (see ReminderEligibilityService's doc comment).
  PAUSED
}

/// One arrears-collection episode for a lot — a human workflow record, not
/// a financial one. A lot may have multiple cases over time (reopenable
/// episodes), never a single mutable singleton, so history of past
/// collection activity is preserved even after a case closes.
model CollectionCase {
  id               String               @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "COL" prefix.
  publicReference  String               @unique
  organisationId   String
  propertyId       String
  spaceId          String
  status           CollectionCaseStatus @default(OPEN)
  assignedToUserId String?
  /// The next date a staff member intends to follow up — purely a
  /// reminder-to-self field, never a deadline the system enforces.
  nextFollowUpDate DateTime?            @db.Date

  openedByUserId String
  openedAt       DateTime  @default(now())
  closedByUserId String?
  closedAt       DateTime?
  closeReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation      @relation(fields: [organisationId], references: [id])
  property       Property          @relation(fields: [propertyId], references: [id])
  space          Space             @relation(fields: [spaceId], references: [id])
  assignedToUser User?             @relation("CollectionCaseAssignedTo", fields: [assignedToUserId], references: [id])
  openedByUser   User              @relation("CollectionCaseOpenedBy", fields: [openedByUserId], references: [id])
  closedByUser   User?             @relation("CollectionCaseClosedBy", fields: [closedByUserId], references: [id])
  notes          CollectionNote[]
  reminders      PaymentReminder[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([spaceId])
  @@map("collection_cases")
}

/// A free-text follow-up entry against a CollectionCase — a phone call, a
/// letter sent, a payment-plan agreement, anything a staff member wants on
/// the record. Immutable once created (no edit/delete route), same
/// append-only discipline as every other audited event in this system.
model CollectionNote {
  id               String  @id @default(cuid())
  collectionCaseId String
  organisationId   String
  propertyId       String
  body             String
  /// Whether this note represents an actual attempt to contact the
  /// owner (a call, a letter, a visit) vs. an internal-only note (e.g.
  /// "flagged for review") — lets the collection timeline distinguish
  /// real contact attempts from staff bookkeeping.
  contactAttempted Boolean @default(false)
  contactMethod    String?

  createdByUserId String
  createdAt       DateTime @default(now())

  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id])
  organisation   Organisation   @relation(fields: [organisationId], references: [id])
  property       Property       @relation(fields: [propertyId], references: [id])
  createdByUser  User           @relation("CollectionNoteCreatedBy", fields: [createdByUserId], references: [id])

  @@index([collectionCaseId])
  @@index([organisationId])
  @@index([propertyId])
  @@map("collection_notes")
}

/// DRAFT/CANCELLED/SENT/FAILED are M16.6's original four (manual
/// draft-and-preview, never auto-sent). M16.8 extends the SAME model with
/// the full system-generated lifecycle below rather than a parallel
/// table — see ReminderEligibilityService/ReminderApprovalService/
/// ReminderDispatchService's own doc comments for exactly which service
/// drives each transition. A DRAFT reminder (manually created via
/// draftReminder, M16.6) can still only ever reach CANCELLED — it never
/// enters the automated approve/dispatch pipeline, which starts only
/// from READY_FOR_REVIEW.
enum PaymentReminderStatus {
  DRAFT
  CANCELLED
  /// M16.6's original reserved value, now actually used: the terminal
  /// "provider accepted this message" state — never "a human read it".
  SENT
  /// M16.6's original reserved value, now actually used: exhausted
  /// retries / a permanent provider error. Distinct from QUARANTINED
  /// (an ambiguous outcome, never auto-retried) and SUPPRESSED (never
  /// attempted at all).
  FAILED
  /// A system-generated candidate, produced by
  /// ReminderEligibilityService, awaiting manager review. Never created
  /// by the manual draftReminder path.
  READY_FOR_REVIEW
  /// A manager has approved this exact content/recipient/amount — see
  /// PaymentReminder.approvalSnapshot. Never itself a delivery event.
  APPROVED
  /// Atomically claimed by one dispatch-worker instance for processing —
  /// the concurrency-safe "lease" state (mirrors Communication's
  /// SCHEDULED->SENDING claim in communications.delivery.ts), preventing
  /// two workers from both attempting the same send.
  QUEUED
  /// The provider call is actually in flight. If a process crashes/times
  /// out while a reminder sits here, it is NEVER automatically reclaimed
  /// and retried (unlike Communication) — see
  /// ReminderDispatchService.quarantineStuckSending's doc comment for why
  /// that would risk a duplicate real send.
  SENDING
  /// Provider confirmed delivery via a verified webhook callback — never
  /// set any other way, never fabricated from SENT alone.
  DELIVERED
  /// A real eligibility match that a policy/case-state rule explicitly
  /// suppressed (e.g. a DISPUTED case, a reminder cap reached) — kept as
  /// a persisted, reviewable record so a manager can see WHY an overdue
  /// lot did not get a reminder, never silently dropped.
  SUPPRESSED
  /// The unavoidable ambiguous-outcome case: the provider may or may not
  /// have accepted the message before the dispatch attempt errored/timed
  /// out. Never auto-retried (that could duplicate a real send) — a
  /// manager must explicitly resolve it (see
  /// ReminderDispatchService.resolveQuarantine).
  QUARANTINED
}

/// A manually drafted (M16.6) OR system-evaluated (M16.8) payment
/// reminder — `content` is a point-in-time SNAPSHOT of the outstanding
/// charges/amounts, for preview/print only; it is never read back as
/// current arrears truth (ADR-027). `approvalSnapshot` (M16.8) is the
/// SEPARATE, stricter immutable record of exactly what a manager
/// approved — see that field's own doc comment.
model PaymentReminder {
  id               String                @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "PRM" prefix.
  publicReference  String                @unique
  organisationId   String
  propertyId       String
  spaceId          String
  /// Optional — a reminder can be drafted standalone, attached to an
  /// open collection case for a unified timeline, or (M16.8) linked to
  /// whichever non-terminal case already existed for the lot at
  /// evaluation time — eligibility evaluation never creates a case on
  /// its own. See ReminderEligibilityService's doc comment.
  collectionCaseId String?
  status           PaymentReminderStatus @default(DRAFT)
  /// The arrears snapshot date this reminder's content was generated
  /// from — not necessarily today, if drafted against a historical
  /// as-of date for review purposes.
  asOfDate         DateTime              @db.Date
  /// Snapshot total of the charges listed in `content`, for display only.
  totalAmountOwing Decimal               @db.Decimal(14, 2)
  currencyCode     String
  /// The generated reminder body/charge breakdown, stored as JSON —
  /// structured enough for the preview screen to render without
  /// re-parsing free text, but never queried as a source of financial
  /// truth (see this model's own doc comment).
  content          Json

  /// M16.8 — which repeat this is for this lot's current debt episode
  /// (1 = first reminder). Drives both the follow-up-interval timing and
  /// the "no duplicate queued reminder for the same lot+stage" dedup
  /// rule (service-level, not a DB constraint — same precedent as
  /// PostingProfileRule's own duplicate-role check).
  reminderStage     Int     @default(1)
  /// M16.8 — the ReminderPolicy.version in effect when this candidate
  /// was produced (eligibility) or approved — lets a later policy change
  /// never silently reinterpret an already-approved reminder.
  policyVersion     Int?
  /// M16.8 — human-readable reason this candidate was created, or (for
  /// SUPPRESSED) why it was not. Never a source of truth, display only.
  eligibilityReason String?

  /// M16.8 — the resolved recipient, from effective-dated
  /// PropertyMembership/PropertyContact lookup — never inferred from a
  /// lot label or an unrelated organisation user. Null until resolved;
  /// approval is blocked while null (see ReminderApprovalService).
  recipientContactId      String?
  recipientEmail          String?
  /// Set when resolution was ambiguous/impossible (no active owner, a
  /// suspended contact, etc.) — surfaces in the review queue as "needs
  /// manual resolution" rather than silently guessing a recipient.
  recipientResolutionNote String?

  /// M16.8 — set only by ReminderApprovalService.approve, distinct from
  /// generatedByUserId/generatedAt (which record candidate CREATION, by
  /// a human for a manual DRAFT or by the system for READY_FOR_REVIEW).
  approvedByUserId String?
  approvedAt       DateTime?
  /// M16.8 — the IMMUTABLE record of exactly what was approved:
  /// approver, timestamp, recipient (contactId + email), the specific
  /// LotLevyCharge references and amounts, templateVersion and
  /// policyVersion — written once at approval, never edited. Dispatch
  /// revalidates live data against this snapshot and refuses to send on
  /// a mismatch (see ReminderDispatchService.processDue) rather than
  /// ever trusting stale content.
  approvalSnapshot Json?
  /// M16.8 — bumped whenever renderReminderEmail's own template changes
  /// in a way that would alter previously-approved wording; recorded on
  /// the snapshot so a completed send is always traceable to the exact
  /// template version used.
  templateVersion  Int       @default(1)

  /// M16.8 — dispatch bookkeeping on the reminder itself (the
  /// authoritative per-attempt log is PaymentReminderDeliveryAttempt;
  /// these are a denormalised "current state" convenience for list/queue
  /// views so they don't need to join the attempt table).
  dispatchAttempts  Int       @default(0)
  lastAttemptedAt   DateTime?
  lastErrorCategory String?
  /// Set once SENT — the provider's own id for this specific send,
  /// never a secret, safe to display for support/audit purposes.
  providerMessageId String?
  /// SENT means the provider accepted the message — set the instant
  /// EmailService.send() returns successfully. DELIVERED is separate and
  /// strictly later, set only by a verified webhook callback.
  submittedAt       DateTime?
  deliveredAt       DateTime?

  generatedByUserId String?
  generatedAt       DateTime  @default(now())
  cancelledByUserId String?
  cancelledAt       DateTime?

  organisation     Organisation                     @relation(fields: [organisationId], references: [id])
  property         Property                         @relation(fields: [propertyId], references: [id])
  space            Space                            @relation(fields: [spaceId], references: [id])
  collectionCase   CollectionCase?                  @relation(fields: [collectionCaseId], references: [id])
  /// M16.8 — nullable: a system-generated READY_FOR_REVIEW candidate has
  /// no human "generator"; the manual M16.6 draftReminder path still
  /// always sets this.
  generatedByUser  User?                            @relation("PaymentReminderGeneratedBy", fields: [generatedByUserId], references: [id])
  cancelledByUser  User?                            @relation("PaymentReminderCancelledBy", fields: [cancelledByUserId], references: [id])
  recipientContact PropertyContact?                 @relation(fields: [recipientContactId], references: [id])
  approvedByUser   User?                            @relation("PaymentReminderApprovedBy", fields: [approvedByUserId], references: [id])
  deliveryAttempts PaymentReminderDeliveryAttempt[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([spaceId])
  @@index([collectionCaseId])
  @@index([recipientContactId])
  @@index([status])
  @@map("payment_reminders")
}

// --- Strata Financial Management: Arrears Reminder Delivery & Scheduling (M16.8) ---
//
// Extends M16.6's CollectionCase/PaymentReminder — no parallel collections
// system. See ADR-029 for the full decision record. Three load-bearing
// decisions:
//
// 1. Default OFF, two independent switches. ReminderPolicy.enabled gates
//    whether the daily eligibility evaluator runs AT ALL for a property;
//    ReminderPolicy.deliveryEnabled is a SEPARATE gate a manager must also
//    explicitly turn on before the dispatch worker will ever attempt a real
//    send — on top of (never instead of) the process-wide
//    EMAIL_SEND_DISABLED kill switch. A property can review/approve
//    candidates with evaluation on and delivery off.
//
// 2. Approval is a snapshot, not a pointer. PaymentReminder.approvalSnapshot
//    freezes exactly what a manager approved (amount, recipient, charges,
//    template/policy version). Both approve() and dispatch() independently
//    recompute live arrears/recipient/case-state and refuse to proceed on
//    any mismatch — never send on stale content, per ADR-029.
//
// 3. Ambiguous delivery outcomes are quarantined, never retried. A
//    PaymentReminderDeliveryAttempt row is written before the provider
//    call and updated after; if the process never reaches the "after" step
//    (crash/timeout), the attempt is left PENDING and the reminder sits in
//    SENDING — a manager must explicitly resolve it
//    (ReminderDispatchService.resolveQuarantine), never an automatic retry
//    that risks a duplicate real email.

enum PaymentReminderDeliveryOutcome {
  SENT
  FAILED
  /// The provider call's own outcome could not be determined (e.g. a
  /// network timeout after the request was already sent) — see this
  /// section's doc comment, point 3.
  AMBIGUOUS
}

/// One row per property — created on first PUT, default OFF. See this
/// section's doc comment, point 1, for why `enabled` and `deliveryEnabled`
/// are deliberately two separate switches.
model ReminderPolicy {
  id              String @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "RPOL" prefix.
  publicReference String @unique
  organisationId  String
  propertyId      String @unique

  /// Master switch for the daily eligibility evaluator — while false, no
  /// READY_FOR_REVIEW/SUPPRESSED candidates are ever created for this
  /// property, regardless of how overdue a lot is.
  enabled         Boolean @default(false)
  /// Separate switch the dispatch worker also checks before any real
  /// provider call — approving a reminder is possible with this off; a
  /// human must deliberately decide the property is ready for automated
  /// email delivery, not just arrears tracking.
  deliveryEnabled Boolean @default(false)

  /// Days after a charge's due date before its FIRST reminder becomes
  /// eligible. Conservative default — a real property must confirm this
  /// before relying on it.
  initialDelayDays            Int     @default(14)
  /// Days between one SENT/DELIVERED reminder and the next eligible
  /// follow-up for the same lot.
  followUpIntervalDays        Int     @default(14)
  /// A lot's total overdue amount must be at least this much before any
  /// reminder is eligible — avoids reminders for trivial cent-level
  /// residual balances.
  minimumOutstandingAmount    Decimal @default(0) @db.Decimal(14, 2)
  /// Optional lifetime cap on SENT/DELIVERED reminders for one
  /// CollectionCase — null means no cap.
  maxRemindersPerCase         Int?
  /// Optional rolling-window cap — at most
  /// maxRemindersInRollingWindow SENT/DELIVERED reminders per lot within
  /// the trailing rollingWindowDays. Both null, or both set — never one
  /// without the other (validated in ReminderPolicyService).
  maxRemindersInRollingWindow Int?
  rollingWindowDays           Int?

  /// IANA zone the evaluator computes "today"/due-date boundaries in —
  /// every instant is still stored in UTC (DateTime columns throughout
  /// this schema); only the day-boundary math for eligibility is
  /// timezone-aware. Australia/Sydney for the NSW MVP, configurable per
  /// property for a future non-NSW scheme.
  timezone String @default("Australia/Sydney")

  /// Bumped on every update — snapshotted onto each PaymentReminder
  /// (policyVersion) so a later policy change never silently reinterprets
  /// an already-created or already-approved reminder.
  version Int @default(1)

  /// Observability only, never read back as a gating condition — the
  /// evaluator's own idempotency comes from the per-(lot, stage) dedup
  /// check, not from this timestamp.
  lastEvaluatedAt    DateTime?
  lastEvaluationNote String?

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation  Organisation @relation(fields: [organisationId], references: [id])
  property      Property     @relation(fields: [propertyId], references: [id])
  updatedByUser User?        @relation("ReminderPolicyUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([organisationId])
  @@map("reminder_policies")
}

/// One row per dispatch attempt — the authoritative, append-only delivery
/// log (PaymentReminder's own dispatchAttempts/lastAttemptedAt/etc. are a
/// denormalised "current state" convenience, never the source of truth).
/// `idempotencyKey` is unique so a retried/duplicated worker claim can
/// never write two rows for what is meant to be the same attempt.
model PaymentReminderDeliveryAttempt {
  id                String @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "PRDA" prefix.
  publicReference   String @unique
  organisationId    String
  propertyId        String
  paymentReminderId String
  attemptNumber     Int
  /// `{paymentReminderId}:{attemptNumber}` — see
  /// ReminderDispatchService.dispatchOne for exactly how this is used to
  /// make a repeated API call/worker retry a no-op rather than a second
  /// real send.
  idempotencyKey    String @unique

  /// Null while the attempt is in flight (provider call not yet
  /// returned) — see this section's doc comment, point 3, on why a row
  /// stuck null here is quarantined, never auto-retried.
  outcome PaymentReminderDeliveryOutcome?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// The provider's own id for this specific send — never a secret, safe
  /// to display for support/audit purposes.
  providerMessageId String?
  /// A short category ("TRANSIENT" / "PERMANENT" / "TIMEOUT"), never the
  /// raw provider error payload (which could carry recipient PII or
  /// provider-internal detail this codebase doesn't log elsewhere).
  errorCategory     String?
  errorMessage      String?

  paymentReminder PaymentReminder @relation(fields: [paymentReminderId], references: [id])
  organisation    Organisation    @relation(fields: [organisationId], references: [id])
  property        Property        @relation(fields: [propertyId], references: [id])

  @@index([paymentReminderId])
  @@index([organisationId])
  @@index([propertyId])
  @@map("payment_reminder_delivery_attempts")
}

// --- Strata Financial Management: Banking & Manual Bank Reconciliation (M16.7) ---
//
// Builds on M16.2.2's General Ledger (JournalEntry/JournalLine) and M16.5's
// Receipt/PaymentAllocation — no parallel financial truth source. Five
// load-bearing decisions:
//
// 1. Importing a bank statement never posts a GL journal. A BankTransaction
//    is a read-only record of what the bank's own statement says happened;
//    it becomes economically real in WaslProp's books only when MATCHED to
//    an existing Receipt/JournalLine, or when a manager explicitly uses it
//    to create a new Receipt via the existing ReceiptsService (the only
//    receipt-posting path in this codebase — see BankMatchType.NEW_RECEIPT).
//
// 2. Matching and reconciliation are separate concepts, per this
//    milestone's own brief. BankTransactionMatch links one bank movement to
//    one existing accounting record. BankReconciliation separately confirms
//    that, for a whole statement period, the bank account's statement
//    balance and the GL cash account's balance agree — it does not itself
//    link individual transactions (BankTransaction.reconciliationId does).
//
// 3. A bank account's own identifier is never persisted in recoverable
//    form. BankAccount.accountIdentifierMasked is the ONLY thing stored —
//    derived once at registration (keeping only the last 4 characters
//    visible) and the raw value is discarded immediately after. This
//    trivially satisfies "never unmasked in logs/activity events/ordinary
//    API responses" because the unmasked value is never persisted at all,
//    not because it is filtered on the way out.
//
// 4. Duplicate-import detection does not rely on date+amount alone (an MVP
//    CSV frequently has no stable bank transaction id). BankTransaction.
//    sourceRowHash is a SHA-256 of (bankAccountId, transactionDate, amount,
//    description, bankReference, runningBalance) — unique per bank account
//    — so two genuinely identical-looking legitimate transactions on the
//    same day are distinguished only by whatever the statement itself
//    distinguishes them by (typically a distinct runningBalance); see
//    bank-import.service.ts's doc comment for the full strategy and its
//    known limitation.
//
// 5. A completed BankReconciliation is immutable history, same discipline
//    as a POSTED JournalEntry — correction is REOPENED (an explicit,
//    audited status change, not a silent mutation of the original
//    snapshot fields) plus a fresh superseding DRAFT, never an in-place
//    edit of a RECONCILED row's own balances.

enum BankAccountType {
  OPERATING
  RESERVE
  TRUST
  OTHER
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
}

/// A property-scoped registry entry for a real-world bank account — see
/// this section's doc comment, point 3, for why no unmasked identifier is
/// ever persisted. Deliberately NOT assumed to be 1:1 with a
/// FinancialFund (see this milestone's brief) — `financialFundId` is an
/// optional convenience association; `glCashAccountId` is the one
/// authoritative link into the chart of accounts, explicitly chosen at
/// registration (mirrors Receipt.destinationAccountId's own
/// resolved-and-snapshotted-once discipline) rather than re-resolved via
/// the posting profile on every use.
model BankAccount {
  id                       String            @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "BANK" prefix.
  publicReference          String            @unique
  organisationId           String
  propertyId               String
  financialConfigurationId String
  accountName              String
  institutionName          String
  /// The ONLY persisted representation of the account identifier — e.g.
  /// "••••1234". See this section's doc comment, point 3.
  accountIdentifierMasked  String
  currencyCode             String
  accountType              BankAccountType
  /// The GL cash account this bank account's movements post against —
  /// must be ASSET-classified and belong to the same property; see
  /// BankAccountsService.register for the validation. Required: every
  /// bank account must have somewhere in the GL its balance corresponds
  /// to, even before any statement is ever imported.
  glCashAccountId          String
  /// Optional — set only when this bank account genuinely corresponds to
  /// one fund's own cash (the common case for a dedicated Capital Works
  /// reserve account); null for an operating account whose statement
  /// mixes multiple funds' cash (matching/allocation then happens at the
  /// transaction level, same as a multi-fund Receipt's own fund choice).
  financialFundId          String?
  status                   BankAccountStatus @default(ACTIVE)
  /// The reconciled balance and date WaslProp's own reconciliation history
  /// starts from — set once at registration (optional: a brand-new bank
  /// account with no prior history simply starts at 0.00 from today, same
  /// "never fabricate history before this date" discipline as
  /// FinancialConfiguration.cutoverDate), frozen thereafter; never updated
  /// after the first BankReconciliation against this account is created.
  openingReconciledBalance Decimal?          @db.Decimal(14, 2)
  openingReconciledDate    DateTime?         @db.Date

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  financialConfiguration FinancialConfiguration @relation(fields: [financialConfigurationId], references: [id])
  glCashAccount          AccountingAccount      @relation(fields: [glCashAccountId], references: [id])
  financialFund          FinancialFund?         @relation(fields: [financialFundId], references: [id])
  createdByUser          User                   @relation("BankAccountCreatedBy", fields: [createdByUserId], references: [id])
  imports                BankStatementImport[]
  transactions           BankTransaction[]
  reconciliations        BankReconciliation[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([glCashAccountId])
  @@index([financialFundId])
  @@map("bank_accounts")
}

/// One applied CSV statement upload — provenance record only (mirrors
/// AccountImportBatch exactly: preview is a pure, unpersisted computation,
/// nothing is written until `apply`). `fileHash` is the SHA-256 of the
/// raw, normalized file content — a second upload of the byte-identical
/// file against the same bank account is rejected outright before any
/// row-level duplicate detection even runs (see bank-import.service.ts).
model BankStatementImport {
  id                 String    @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "BIMP" prefix.
  publicReference    String    @unique
  organisationId     String
  propertyId         String
  bankAccountId      String
  fileName           String
  fileHash           String
  statementStartDate DateTime? @db.Date
  statementEndDate   DateTime? @db.Date
  totalRows          Int
  importedCount      Int
  /// Rows present in the file but skipped as duplicates of an
  /// already-imported transaction (same bank account, different import).
  duplicateCount     Int
  importedByUserId   String
  importedAt         DateTime  @default(now())

  organisation   Organisation      @relation(fields: [organisationId], references: [id])
  property       Property          @relation(fields: [propertyId], references: [id])
  bankAccount    BankAccount       @relation(fields: [bankAccountId], references: [id])
  importedByUser User              @relation("BankStatementImportBy", fields: [importedByUserId], references: [id])
  transactions   BankTransaction[]

  @@unique([bankAccountId, fileHash])
  @@index([organisationId])
  @@index([propertyId])
  @@index([bankAccountId])
  @@map("bank_statement_imports")
}

/// UNMATCHED -> SUGGESTED -> MATCHED, or -> IGNORED (a manager's explicit
/// "this will never be matched" dismissal, e.g. a bank fee the scheme
/// chooses not to book). SUGGESTED means the matching engine has proposed
/// a match (a BankTransactionMatch row with status SUGGESTED exists) that
/// no one has confirmed yet.
enum BankTransactionMatchStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  IGNORED
}

/// Separate from matching (see this section's doc comment, point 2) — set
/// only once this transaction is included in a BankReconciliation
/// (DRAFT or later), cleared back to UNRECONCILED if that reconciliation
/// is later reopened.
enum BankTransactionReconciliationStatus {
  UNRECONCILED
  RECONCILED
}

/// One normalized row from an imported bank statement — amount is signed
/// (credit/deposit positive, debit/payment negative), always exact Decimal,
/// never a float. See this section's doc comment, point 4, for
/// `sourceRowHash`'s role in duplicate detection.
model BankTransaction {
  id                    String                              @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "BTX" prefix.
  publicReference       String                              @unique
  organisationId        String
  propertyId            String
  bankAccountId         String
  importBatchId         String
  transactionDate       DateTime                            @db.Date
  /// The settlement/value date, if the statement provides one separately
  /// from the transaction date — optional, display-only in this MVP.
  valueDate             DateTime?                           @db.Date
  amount                Decimal                             @db.Decimal(14, 2)
  currencyCode          String
  description           String
  bankReference         String?
  /// The statement's own running balance after this row, if provided —
  /// never used as an authoritative balance by itself, only as
  /// corroborating evidence for duplicate detection and row validation.
  runningBalance        Decimal?                            @db.Decimal(14, 2)
  /// A stable bank-provided transaction id, if the CSV has one — when
  /// present, duplicate detection trusts it directly; see
  /// bank-import.service.ts.
  externalTransactionId String?
  /// SHA-256 hex digest — see this section's doc comment, point 4.
  sourceRowHash         String
  matchStatus           BankTransactionMatchStatus          @default(UNMATCHED)
  reconciliationStatus  BankTransactionReconciliationStatus @default(UNRECONCILED)
  reconciliationId      String?

  createdAt DateTime @default(now())

  organisation   Organisation           @relation(fields: [organisationId], references: [id])
  property       Property               @relation(fields: [propertyId], references: [id])
  bankAccount    BankAccount            @relation(fields: [bankAccountId], references: [id])
  importBatch    BankStatementImport    @relation(fields: [importBatchId], references: [id])
  reconciliation BankReconciliation?    @relation(fields: [reconciliationId], references: [id])
  matches        BankTransactionMatch[]

  /// The core duplicate-import guard — see this section's doc comment,
  /// point 4.
  @@unique([bankAccountId, sourceRowHash])
  @@index([organisationId])
  @@index([propertyId])
  @@index([bankAccountId])
  @@index([importBatchId])
  @@index([reconciliationId])
  @@index([matchStatus])
  @@map("bank_transactions")
}

/// What kind of existing accounting record a bank transaction was matched
/// to. RECEIPT/JOURNAL_LINE link to something that already existed before
/// the match; NEW_RECEIPT records that confirming this match is what
/// CAUSED a new Receipt to be posted (via the existing ReceiptsService —
/// see this section's doc comment, point 1).
enum BankMatchType {
  RECEIPT
  JOURNAL_LINE
  NEW_RECEIPT
}

/// SUGGESTED -> CONFIRMED, or -> REVERSED (never edited in place — a
/// reversed suggestion/confirmation is superseded by a fresh row, same
/// "reversal is its own event" discipline as PaymentAllocationStatus).
enum BankMatchStatus {
  SUGGESTED
  CONFIRMED
  REVERSED
}

/// One proposed-or-confirmed link between a BankTransaction and an
/// existing (or, for NEW_RECEIPT, newly created) accounting record. At
/// most one SUGGESTED-or-CONFIRMED row may exist per BankTransaction at a
/// time (enforced in bank-matching.service.ts, not a DB constraint — same
/// "service-level dedup" precedent as PostingProfileRule) — "do not match
/// the same bank transaction twice". At most one CONFIRMED row may ever
/// reference the same receiptId — "do not allocate the same receipt
/// twice", checked the same way.
model BankTransactionMatch {
  id                String          @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "BMTCH" prefix.
  publicReference   String          @unique
  organisationId    String
  propertyId        String
  bankTransactionId String
  matchType         BankMatchType
  /// Set for RECEIPT and NEW_RECEIPT match types.
  receiptId         String?
  /// Set for JOURNAL_LINE match types — the existing GL cash movement
  /// (e.g. a manual journal for bank charges/interest) this transaction
  /// corresponds to.
  journalLineId     String?
  /// A short machine-readable reason code (e.g. "UNIQUE_REFERENCE",
  /// "EXACT_AMOUNT_LOT", "EXACT_AMOUNT_DATE") driving `explanation` — see
  /// bank-matching.service.ts's priority-ordered rule list.
  confidence        String
  /// The human-readable reason shown to the manager — see this
  /// milestone's brief example ("Unique reference and exact amount
  /// match.").
  explanation       String
  status            BankMatchStatus @default(SUGGESTED)

  suggestedByUserId String?
  suggestedAt       DateTime  @default(now())
  confirmedByUserId String?
  confirmedAt       DateTime?
  reversedByUserId  String?
  reversedAt        DateTime?
  reversalReason    String?

  organisation    Organisation    @relation(fields: [organisationId], references: [id])
  property        Property        @relation(fields: [propertyId], references: [id])
  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id])
  receipt         Receipt?        @relation(fields: [receiptId], references: [id])
  journalLine     JournalLine?    @relation(fields: [journalLineId], references: [id])
  confirmedByUser User?           @relation("BankTransactionMatchConfirmedBy", fields: [confirmedByUserId], references: [id])
  reversedByUser  User?           @relation("BankTransactionMatchReversedBy", fields: [reversedByUserId], references: [id])

  @@index([organisationId])
  @@index([propertyId])
  @@index([bankTransactionId])
  @@index([receiptId])
  @@index([journalLineId])
  @@index([status])
  @@map("bank_transaction_matches")
}

enum BankReconciliationStatus {
  DRAFT
  IN_REVIEW
  RECONCILED
  REOPENED
}

/// One statement-period reconciliation of a bank account against its GL
/// cash account — see this section's doc comment, point 2 and point 5.
/// `difference` is the core output of BankReconciliationService.calculate
/// — see that method's doc comment for the exact equation. A RECONCILED
/// row's balance fields are never edited again; `supersedesReconciliationId`
/// links a later correcting reconciliation back to the one it replaces.
model BankReconciliation {
  id                         String                   @id @default(cuid())
  /// See Property.publicReference's doc comment — same system, "RECN" prefix.
  publicReference            String                   @unique
  organisationId             String
  propertyId                 String
  bankAccountId              String
  periodStartDate            DateTime                 @db.Date
  periodEndDate              DateTime                 @db.Date
  statementOpeningBalance    Decimal                  @db.Decimal(14, 2)
  statementClosingBalance    Decimal                  @db.Decimal(14, 2)
  /// Snapshotted GL cash account balance as of periodStartDate/periodEndDate
  /// at the time `calculate` last ran — re-computed on every calculate
  /// call while still DRAFT/IN_REVIEW, frozen once RECONCILED.
  glOpeningBalance           Decimal                  @db.Decimal(14, 2)
  glClosingBalance           Decimal                  @db.Decimal(14, 2)
  /// Net of GL cash lines in-period not yet linked to any bank transaction
  /// via a CONFIRMED BankTransactionMatch — split for display into the
  /// deposit (debit) and payment (credit) components.
  outstandingDepositsTotal   Decimal                  @default(0) @db.Decimal(14, 2)
  unpresentedPaymentsTotal   Decimal                  @default(0) @db.Decimal(14, 2)
  /// glClosingBalance - outstandingDepositsTotal + unpresentedPaymentsTotal
  /// - statementClosingBalance — see BankReconciliationService.calculate's
  /// doc comment. Must be exactly 0.00 for `complete` to succeed.
  difference                 Decimal                  @default(0) @db.Decimal(14, 2)
  status                     BankReconciliationStatus @default(DRAFT)
  supersedesReconciliationId String?                  @unique

  preparedByUserId String
  reviewedByUserId String?
  completedAt      DateTime?
  reopenedByUserId String?
  reopenedAt       DateTime?
  reopenReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation        @relation(fields: [organisationId], references: [id])
  property       Property            @relation(fields: [propertyId], references: [id])
  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id])
  preparedByUser User                @relation("BankReconciliationPreparedBy", fields: [preparedByUserId], references: [id])
  reviewedByUser User?               @relation("BankReconciliationReviewedBy", fields: [reviewedByUserId], references: [id])
  reopenedByUser User?               @relation("BankReconciliationReopenedBy", fields: [reopenedByUserId], references: [id])
  supersedes     BankReconciliation? @relation("BankReconciliationSupersede", fields: [supersedesReconciliationId], references: [id])
  supersededBy   BankReconciliation? @relation("BankReconciliationSupersede")
  transactions   BankTransaction[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([bankAccountId])
  @@index([status])
  @@map("bank_reconciliations")
}

/// A business/person record: an owner, tenant or resident on file for an
/// organisation. Independent of login — userId is set only once this contact
/// activates portal access (Slice 2), and stays nullable forever otherwise.
/// userId is deliberately unique only *per organisation*, not globally: a
/// single User can be the property-scoped portal identity for at most one
/// contact within any given organisation, but for one contact in each of
/// several different organisations simultaneously (e.g. a property manager
/// at Org A who is also a tenant at Org B) — one account, one login, the
/// existing organisation-picker at login time (AuthService.listAccessOptions)
/// simply returns one more option. Never let two contacts in the *same*
/// organisation link to the same user — that would make "which one did they
/// mean" ambiguous for every property-scoped request in that org.
model PropertyContact {
  id             String        @id @default(cuid())
  organisationId String
  userId         String?
  firstName      String
  lastName       String
  email          String
  phone          String?
  status         ContactStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation            Organisation             @relation(fields: [organisationId], references: [id])
  user                    User?                    @relation(fields: [userId], references: [id])
  memberships             PropertyMembership[]
  invites                 ContactInvite[]
  communicationRecipients CommunicationRecipient[]
  sessions                Session[]
  /// M16.8 — every PaymentReminder this contact was resolved as the
  /// recipient for.
  paymentReminders        PaymentReminder[]

  @@unique([organisationId, email])
  @@unique([organisationId, userId])
  @@index([organisationId])
  @@map("property_contacts")
}

enum ContactStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// The relationship between a contact and a property or a specific space
/// within it (spaceId is nullable so property-level roles like Property
/// Manager / Facility Manager are representable alongside space-level roles
/// like Owner / Tenant / Resident).
model PropertyMembership {
  id             String           @id @default(cuid())
  organisationId String
  propertyId     String
  spaceId        String?
  contactId      String
  role           PropertyRole
  startDate      DateTime
  endDate        DateTime?
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  property Property        @relation(fields: [propertyId], references: [id])
  space    Space?          @relation(fields: [spaceId], references: [id])
  contact  PropertyContact @relation(fields: [contactId], references: [id])

  @@index([organisationId])
  @@index([propertyId])
  @@index([spaceId])
  @@index([contactId])
  @@map("property_memberships")
}

enum PropertyRole {
  OWNER
  TENANT
  RESIDENT
  PROPERTY_MANAGER
  FACILITY_MANAGER
  AGENT
  COMMITTEE_MEMBER
}

/// Configurable property-scoped Roles & Permissions (property-role
/// authorization milestone). Stores ONLY deviations from the WaslProp
/// system-default capability set for a (organisation, PropertyRole) pair —
/// see src/modules/authorization/capabilities.ts for the defaults and the
/// full capability catalogue. An organisation with zero rows here behaves
/// exactly like the system defaults; "restore defaults" for a role is a
/// bulk delete of that role's rows, not a rewrite. `capability` is a
/// string, not an enum, deliberately — see that file's own doc comment for
/// why. `granted=true` adds a capability the default doesn't include;
/// `granted=false` removes a capability the default does include.
model OrganisationRolePermission {
  id             String       @id @default(cuid())
  organisationId String
  role           PropertyRole
  /// Must be one of CAPABILITIES in capabilities.ts — validated at the API
  /// layer, not by the database.
  capability     String
  granted        Boolean
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, role, capability])
  @@index([organisationId])
  @@map("organisation_role_permissions")
}

enum MembershipStatus {
  ACTIVE
  ENDED
}

// --- Activity (Slice 1 / M5) ---

/// Wasl Property's own operational history for a property/space (created,
/// updated, people added, ...). This is deliberately separate from
/// WaslSign's agreement/signature audit trail, which WaslSign continues to
/// own — this log never records signing events.
model ActivityEvent {
  id             String            @id @default(cuid())
  organisationId String
  /// Nullable to represent organisation-wide events (e.g. a portfolio-wide
  /// announcement) that aren't scoped to a single property. Every other
  /// event type still always supplies this.
  propertyId     String?
  spaceId        String?
  actorUserId    String?
  eventType      ActivityEventType
  entityType     String?
  entityId       String?
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])
  space        Space?       @relation(fields: [spaceId], references: [id])
  actorUser    User?        @relation(fields: [actorUserId], references: [id])

  @@index([organisationId])
  @@index([organisationId, createdAt])
  @@index([propertyId, createdAt])
  @@index([spaceId, createdAt])
  @@map("activity_events")
}

/// Only event types for actions that already exist. Extend this enum when
/// a new module actually ships (e.g. maintenance, work orders) rather than
/// pre-declaring values nothing can emit yet.
enum ActivityEventType {
  PROPERTY_CREATED
  PROPERTY_UPDATED
  SPACE_CREATED
  SPACE_UPDATED
  PERSON_ADDED
  MAINTENANCE_REQUEST_CREATED
  MAINTENANCE_REQUEST_STATUS_CHANGED
  MAINTENANCE_REQUEST_UPDATED
  MAINTENANCE_REQUEST_ATTACHMENTS_ADDED
  WORK_ORDER_CREATED
  WORK_ORDER_STATUS_CHANGED
  CONTRACTOR_ASSIGNED
  QUOTE_SUBMITTED
  QUOTE_WORKFLOW_REQUESTED
  QUOTE_APPROVED
  QUOTE_REJECTED
  QUOTE_SIGNING_STARTED
  QUOTE_SIGNED
  QUOTE_DECLINED
  MEMBERSHIP_UPDATED
  MEMBERSHIP_ENDED
  ANNOUNCEMENT_CREATED
  ANNOUNCEMENT_SENT
  ANNOUNCEMENT_CANCELLED
  ROLE_PERMISSIONS_UPDATED
  CONTRACTOR_CREDENTIAL_ADDED
  CONTRACTOR_CREDENTIAL_UPDATED
  CONTRACTOR_CREDENTIAL_VERIFIED
  CONTRACTOR_CREDENTIAL_REJECTED
  CONTRACTOR_CREDENTIAL_REMOVED
  CONTRACTOR_COMPLIANCE_REQUIREMENTS_UPDATED
  PROCUREMENT_PATH_CHOSEN
  QUOTE_ROUND_CREATED
  QUOTE_ROUND_CONTRACTOR_INVITED
  QUOTE_ROUND_QUOTE_WITHDRAWN
  QUOTE_SELECTED
  QUOTE_ROUND_AWARDED
  QUOTE_ROUND_CANCELLED
  WORK_ORDER_AUTHORISED
  WORK_ORDER_VARIATION_CREATED
  WORK_ORDER_VARIATION_APPROVED
  WORK_ORDER_VARIATION_REJECTED
  WORK_ORDER_VARIATION_CANCELLED
  /// Covers create/update/enable/disable of the organisation's Approval &
  /// Acceptance policy — one coarse event type, matching the existing
  /// CONTRACTOR_COMPLIANCE_REQUIREMENTS_UPDATED precedent, not a noisy
  /// event per field edited.
  APPROVAL_POLICY_UPDATED
  /// A manager confirmed (or strengthened) the Approval & Acceptance
  /// workflow a variation will go through — mirrors QUOTE_WORKFLOW_REQUESTED
  /// in spirit, added as its own event since quotes never actually record
  /// this step today (see WorkOrderVariationsService.setWorkflowMode).
  WORK_ORDER_VARIATION_WORKFLOW_CONFIRMED
  WORK_ORDER_VARIATION_SIGNATURE_STARTED
  WORK_ORDER_VARIATION_SIGNED
  /// A signature was declined/expired — the variation stays unauthorised
  /// (never REJECTED, mirroring how a quote's failed signature leaves its
  /// status alone too — see workflow-result.ts's FAILED case).
  WORK_ORDER_VARIATION_SIGNATURE_FAILED
  /// The one canonical "this variation now counts toward the authorised
  /// total" event, fired at the exact moment status becomes APPROVED via
  /// any of the three workflow paths (NONE / APPROVAL_ONLY /
  /// APPROVAL_THEN_SIGNATURE) — see WorkOrderVariationsService.
  WORK_ORDER_VARIATION_AUTHORISED
  /// The property entered the guided "Enable Strata Management" flow
  /// (NOT_ENABLED -> SETUP_IN_PROGRESS) — fired once, not on every field
  /// edit made while still in setup (see StrataPlanConfigured below for
  /// that).
  STRATA_ENABLED
  /// The Strata Plan's own fields (number, scheme name, declared total
  /// UOE) were set/changed — one coarse event, matching the existing
  /// APPROVAL_POLICY_UPDATED/CONTRACTOR_COMPLIANCE_REQUIREMENTS_UPDATED
  /// precedent rather than one event per field.
  STRATA_PLAN_CONFIGURED
  /// One or more lots' Units of Entitlement were set/changed in a single
  /// save (the wizard's bulk "Lots & Units" step, or a later edit) — one
  /// event per save, never one per lot, to avoid a noisy trail when
  /// entering 100+ lots.
  STRATA_ENTITLEMENTS_UPDATED
  /// A warning signal only, never a block: a lot/UOE or classification
  /// edit on an already-ACTIVE scheme left SUM(lot UOE) no longer equal
  /// to the declared Strata Plan total. completeSetup() enforces this as
  /// a hard gate before a scheme may ever BECOME ACTIVE; once ACTIVE,
  /// legitimate edits (a lot's entitlement correction, a reclassification)
  /// must still be allowed, so this fires instead of blocking, giving
  /// staff an explicit, visible prompt to reconcile rather than a silent
  /// divergence only noticed if someone happens to check the summary.
  STRATA_RECONCILIATION_MISMATCH
  /// SETUP_IN_PROGRESS -> ACTIVE — the guided setup flow's final step.
  STRATA_SETUP_COMPLETED
  /// M15 — AI-assisted strata onboarding lifecycle. These are
  /// document-level events (no propertyId yet, since no Property exists
  /// until STRATA_PROPERTY_CREATED_FROM_PLAN) except the last one, which
  /// is also the familiar PROPERTY_CREATED-style event but fired on the
  /// resulting property. One event per lifecycle stage, never one per
  /// extracted field.
  STRATA_PLAN_UPLOADED
  STRATA_PLAN_ANALYSIS_STARTED
  STRATA_PLAN_ANALYSIS_COMPLETED
  STRATA_PLAN_ANALYSIS_FAILED
  STRATA_PLAN_CONFIRMED
  STRATA_PROPERTY_CREATED_FROM_PLAN
  /// M16.1 — financial onboarding lifecycle, mirroring the STRATA_ENABLED /
  /// STRATA_PLAN_CONFIGURED / STRATA_ENTITLEMENTS_UPDATED /
  /// STRATA_SETUP_COMPLETED granularity: one coarse event per wizard step
  /// saved, never one per field.
  FINANCIAL_SETUP_STARTED
  FINANCIAL_YEAR_CONFIGURED
  FINANCIAL_FUNDS_CONFIGURED
  FINANCIAL_LOT_POSITIONS_CONFIGURED
  /// NOT_CONFIGURED/SETUP_IN_PROGRESS -> ACTIVE — the explicit, deliberate
  /// activation action (never automatic). See financials.service.ts.
  FINANCIAL_SETUP_ACTIVATED
  /// M16.2 — budget lifecycle, one coarse event per stage (never one per
  /// line edit — see budgets.service.ts).
  FINANCIAL_BUDGET_CREATED
  /// Fired for a CREATED budget's approve() call — a genuine
  /// approval-within-WaslProp action.
  FINANCIAL_BUDGET_APPROVED
  /// Fired for an IMPORTED budget's approve() call instead of
  /// FINANCIAL_BUDGET_APPROVED — this records that the import was
  /// confirmed in WaslProp, never that WaslProp witnessed the scheme's own
  /// (pre-existing, external) approval. See FinancialBudget.source.
  FINANCIAL_BUDGET_IMPORT_RECORDED
  /// APPROVED -> ACTIVE, demoting whatever was previously ACTIVE for the
  /// same financial year to SUPERSEDED in the same transaction.
  FINANCIAL_BUDGET_ACTIVATED
  /// A new DRAFT version was created from an APPROVED/ACTIVE budget —
  /// fired once per revision created, not per subsequent line edit.
  FINANCIAL_BUDGET_REVISED
  /// M16.2.1 — chart of accounts. One event per account created/
  /// deactivated (never per field edit); one per applied import batch
  /// (never per row).
  FINANCIAL_ACCOUNT_CREATED
  FINANCIAL_ACCOUNT_UPDATED
  FINANCIAL_ACCOUNT_DEACTIVATED
  FINANCIAL_ACCOUNTS_IMPORTED
  /// M16.2.2 — General Ledger & Posting Engine.
  FINANCIAL_PERIOD_OPENED
  FINANCIAL_PERIOD_CLOSED
  FINANCIAL_PERIOD_REOPENED
  FINANCIAL_POSTING_PROFILE_UPDATED
  FINANCIAL_JOURNAL_POSTED
  FINANCIAL_JOURNAL_REVERSED
  FINANCIAL_OPENING_JOURNAL_POSTED
  /// M16.3 — Levy Management & UOE Allocation.
  LEVY_SCHEDULE_CREATED
  LEVY_SCHEDULE_APPROVED
  /// Pre-ADR-024 legacy — a whole schedule issued/reversed in one action.
  /// No longer written by new code; see LEVY_INSTALLMENT_ISSUED/REVERSED.
  LEVY_SCHEDULE_ISSUED
  LEVY_SCHEDULE_CANCELLED
  /// Pre-ADR-024 legacy — see LEVY_SCHEDULE_ISSUED's doc comment.
  LEVY_SCHEDULE_REVERSED
  LEVY_CHARGE_ADJUSTED
  LEVY_NOTICE_SENT
  /// ADR-024 — one specific instalment issued (never the whole schedule).
  LEVY_INSTALLMENT_ISSUED
  /// ADR-024 — one specific instalment reversed.
  LEVY_INSTALLMENT_REVERSED
  /// M16.5 — Receipts & Payment Allocation (ADR-026).
  RECEIPT_RECORDED
  RECEIPT_REVERSED
  PAYMENT_ALLOCATION_CREATED
  PAYMENT_ALLOCATION_REVERSED
  /// M16.6 — Arrears Management (ADR-027). Workflow events only — nothing
  /// here is a financial posting.
  COLLECTION_CASE_OPENED
  COLLECTION_CASE_UPDATED
  COLLECTION_CASE_CLOSED
  COLLECTION_NOTE_ADDED
  PAYMENT_REMINDER_DRAFTED
  PAYMENT_REMINDER_CANCELLED
  /// M16.7 — Banking & Manual Bank Reconciliation.
  BANK_ACCOUNT_CREATED
  BANK_ACCOUNT_UPDATED
  BANK_STATEMENT_IMPORTED
  BANK_STATEMENT_IMPORT_REJECTED
  BANK_TRANSACTION_MATCH_CONFIRMED
  BANK_TRANSACTION_MATCH_REVERSED
  BANK_RECONCILIATION_STARTED
  BANK_RECONCILIATION_COMPLETED
  BANK_RECONCILIATION_REOPENED
  /// M16.8 — Arrears Reminder Delivery & Scheduling.
  REMINDER_POLICY_UPDATED
  REMINDER_CANDIDATE_CREATED
  REMINDER_CANDIDATE_SUPPRESSED
  REMINDER_APPROVED
  REMINDER_APPROVAL_INVALIDATED
  REMINDER_DISPATCH_SUPPRESSED_BY_KILL_SWITCH
  REMINDER_SENT
  REMINDER_DELIVERY_CONFIRMED
  REMINDER_DELIVERY_FAILED
  REMINDER_DELIVERY_QUARANTINED
  REMINDER_DELIVERY_QUARANTINE_RESOLVED
  REMINDER_DELIVERY_RETRIED
  /// M16.8.1 — manual-draft submission into the unified review pipeline
  /// (ADR-029 Addendum 2), distinguished from the automated
  /// REMINDER_CANDIDATE_CREATED/SUPPRESSED events above so the audit
  /// trail always shows whether a reviewable candidate originated from
  /// a manager's own draft or from the daily eligibility evaluator.
  REMINDER_SUBMITTED_FOR_REVIEW
  REMINDER_SUBMISSION_SUPPRESSED
}

// --- Resident invitations (Slice 2 / M6.5) ---

/// A single-use, expiring invitation for a PropertyContact to activate
/// resident portal access. Only the sha256 hash of the raw token is ever
/// stored — the raw token exists only in the emailed activation link.
model ContactInvite {
  id                String @id @default(cuid())
  organisationId    String
  propertyContactId String
  invitedByUserId   String

  tokenHash String              @unique
  expiresAt DateTime
  status    ContactInviteStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  organisation    Organisation    @relation(fields: [organisationId], references: [id])
  propertyContact PropertyContact @relation(fields: [propertyContactId], references: [id])
  invitedBy       User            @relation(fields: [invitedByUserId], references: [id])

  @@index([organisationId])
  @@index([propertyContactId])
  @@map("contact_invites")
}

enum ContactInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// --- Maintenance (Slice 2 / M6) ---

/// The first operational object in Wasl Property. Deliberately separate
/// from any future WorkOrder concept — a request is what was reported;
/// a work order (later) is the work actually dispatched to resolve it.
model MaintenanceRequest {
  id               String  @id @default(cuid())
  /// See Property.publicReference's doc comment — "MR" prefix.
  publicReference  String  @unique
  organisationId   String
  propertyId       String
  spaceId          String?
  reportedByUserId String?

  title       String
  description String

  category MaintenanceCategory
  priority MaintenancePriority
  status   MaintenanceRequestStatus @default(NEW)

  /// How this request is (or will be) arranged for work — chosen once by an
  /// authorised user via "Arrange work" (see M11). Null until that decision
  /// is made; every request created before M11 stays null forever and
  /// simply never shows the RFQ/procurement UI, matching its pre-M11
  /// behaviour exactly (create a Work Order, assign a contractor directly).
  procurementPath ProcurementPath?

  reportedAt DateTime  @default(now())
  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  space        Space?       @relation(fields: [spaceId], references: [id])
  reportedBy   User?        @relation(fields: [reportedByUserId], references: [id])

  attachments MaintenanceRequestAttachment[]
  workOrders  WorkOrder[]
  quoteRounds QuoteRound[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([spaceId])
  @@index([reportedByUserId])
  @@map("maintenance_requests")
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  COMMON_AREA
  SECURITY
  CLEANING
  PEST_CONTROL
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceRequestStatus {
  NEW
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

/// Photo evidence attached to a maintenance request. Deliberately not a
/// generic document-management model — this exists only for maintenance
/// request photos. Bytes live in S3; only metadata + the storage key live
/// here. Never expose storageKey to the frontend — always mediate access
/// through a freshly-issued presigned GET URL.
model MaintenanceRequestAttachment {
  id                   String  @id @default(cuid())
  organisationId       String
  maintenanceRequestId String
  uploadedByUserId     String?

  storageKey  String
  fileName    String
  contentType String
  fileSize    Int

  width  Int?
  height Int?

  createdAt DateTime @default(now())

  organisation       Organisation       @relation(fields: [organisationId], references: [id])
  maintenanceRequest MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  uploadedBy         User?              @relation(fields: [uploadedByUserId], references: [id])

  @@index([organisationId])
  @@index([maintenanceRequestId])
  @@map("maintenance_request_attachments")
}

// --- Work Orders (M7) ---

/// The work actually dispatched to resolve an issue — deliberately separate
/// from MaintenanceRequest (see that model's doc comment): a request is what
/// was reported, a work order is what a manager decided to do about it.
/// maintenanceRequestId is nullable because a manager can also open a work
/// order directly (e.g. planned/preventive work with no originating report).
model WorkOrder {
  id                   String  @id @default(cuid())
  /// See Property.publicReference's doc comment — "WO" prefix.
  publicReference      String  @unique
  organisationId       String
  propertyId           String
  spaceId              String?
  maintenanceRequestId String?

  title       String
  description String

  status   WorkOrderStatus     @default(DRAFT)
  priority MaintenancePriority

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)
  /// Copied from Organisation.currencyCode at creation — never re-derived
  /// from the (possibly since-changed) organisation setting.
  currencyCode  String   @default("AUD")

  contractorId    String?
  createdByUserId String

  /// Set only when this Work Order was authorised via the M11 RFQ/quote
  /// award flow — the one ContractorQuote whose commercial terms this Work
  /// Order actually represents. Null for a Work Order created the pre-M11
  /// way (Direct Work: create Work Order, assign a contractor, optionally
  /// record a quote against it directly) — that legacy shape keeps working
  /// completely unchanged, it just never populates this link.
  selectedQuoteId String? @unique
  /// Denormalised convenience back-link to the quote round this award came
  /// from, if any — the same fact is already derivable via
  /// selectedQuote.quoteRoundId, kept here too only so a Work Order's own
  /// round can be queried without joining through the quote.
  quoteRoundId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id])
  property           Property            @relation(fields: [propertyId], references: [id])
  space              Space?              @relation(fields: [spaceId], references: [id])
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  contractor         Contractor?         @relation(fields: [contractorId], references: [id])
  createdBy          User                @relation("WorkOrderCreatedBy", fields: [createdByUserId], references: [id])
  selectedQuote      ContractorQuote?    @relation("WorkOrderSelectedQuote", fields: [selectedQuoteId], references: [id])
  quoteRound         QuoteRound?         @relation(fields: [quoteRoundId], references: [id])

  quotes     ContractorQuote[]
  variations WorkOrderVariation[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([spaceId])
  @@index([maintenanceRequestId])
  @@index([contractorId])
  @@index([quoteRoundId])
  @@map("work_orders")
}

enum WorkOrderStatus {
  DRAFT
  READY
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// --- Contractors (M8) ---

model Contractor {
  id              String                @id @default(cuid())
  organisationId  String
  name            String
  companyName     String?
  email           String
  phone           String?
  status          ContractorStatus      @default(ACTIVE)
  /// Free-text specialisations as originally typed by whoever added the
  /// contractor (e.g. "24/7 emergency electrical") — display-only, never
  /// matched against anything. Kept exactly as it was pre-compliance-milestone
  /// for backward compatibility; tradeCategories below is the new,
  /// structured field eligibility actually matches against.
  tradeTypes      String[]
  /// Structured trades this contractor is classified under, reusing
  /// MaintenanceCategory — the same enum a MaintenanceRequest/WorkOrder is
  /// categorised with, so "Electrical work" and "a contractor's Electrical
  /// trade" are always the same value, never a separate disconnected
  /// taxonomy. Empty for every contractor created before this milestone
  /// (and any contractor an admin simply hasn't classified yet) —
  /// deliberately never treated as "matches nothing" for eligibility
  /// purposes; see ContractorEligibilityService's trade-match rule.
  tradeCategories MaintenanceCategory[]
  /// Optional business identifier (e.g. an Australian ABN, or another
  /// jurisdiction's equivalent) — deliberately a plain jurisdiction-neutral
  /// string, never validated against a live registry.
  businessNumber  String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organisation          Organisation           @relation(fields: [organisationId], references: [id])
  workOrders            WorkOrder[]
  quotes                ContractorQuote[]
  credentials           ContractorCredential[]
  quoteRoundInvitations QuoteRoundInvitation[]

  @@unique([organisationId, email])
  @@index([organisationId])
  @@map("contractors")
}

enum ContractorStatus {
  ACTIVE
  INACTIVE
}

// --- Contractor compliance & work eligibility (M12) ---

enum CredentialCategory {
  LICENCE
  CERTIFICATION
  INSURANCE
  QUALIFICATION
  BUSINESS_REGISTRATION
  OTHER
}

/// PENDING = provided but not yet reviewed by an authorised organisation
/// user. VERIFIED = an authorised user manually reviewed it. REJECTED = an
/// authorised user reviewed it and declined it. Never conflated with
/// expiry — CURRENT/EXPIRING_SOON/EXPIRED is derived from
/// (verificationStatus, expiresAt) at read time by
/// ContractorEligibilityService, never stored, so it can never drift out of
/// sync with the clock.
enum CredentialVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// How VERIFIED was reached. Only MANUAL is actually implemented this
/// milestone (an authorised WaslProp user reviewing the uploaded document);
/// REGISTRY/INTEGRATION exist so a future live licensing-body or insurer
/// lookup has somewhere to record itself without another migration — no
/// such integration exists today, and nothing in this codebase claims one
/// does.
enum CredentialVerificationSource {
  MANUAL
  REGISTRY
  INTEGRATION
}

/// A first-class credential/licence/insurance/qualification record for a
/// contractor — deliberately not a pile of named columns on Contractor
/// (contractor.electricalLicenceExpiry, contractor.publicLiabilityExpiry,
/// ...), which cannot represent "which credentials does this contractor
/// actually hold" as data, only as an ever-growing, ever-incomplete schema.
/// One row per credential the contractor holds (a contractor may hold many:
/// several licences, several insurance policies, ...).
model ContractorCredential {
  id             String @id @default(cuid())
  organisationId String
  contractorId   String

  category CredentialCategory
  /// Free-text canonical type, e.g. "Electrical Contractor Licence" or
  /// "Public Liability Insurance" — deliberately not an enum, so a new
  /// credential type never requires a migration (see the milestone's own
  /// "must allow future credential types without a schema migration"
  /// requirement). Matched case-insensitively against
  /// ContractorComplianceRequirement.credentialType. src/modules/contractors/compliance/credentialTypes.ts
  /// offers a starter catalogue of common names for the picker UI, but any
  /// value is accepted — the catalogue is a UX convenience, not an enum.
  type     String

  credentialNumber String?
  /// Issuing authority for a licence/certification, or the insurer/provider
  /// name for an insurance policy — one generic field rather than two
  /// near-identical ones for different credential categories.
  issuer           String?

  issuedAt  DateTime?
  /// Nullable — not every credential expires (e.g. a one-off business
  /// registration number). Never assume every credential has an expiry.
  expiresAt DateTime?

  /// Insurance-only structured metadata — nullable on every other category,
  /// never forced onto a licence/certification/qualification row. Kept as
  /// plain optional columns rather than a separate polymorphic table: only
  /// two fields, only one category uses them, a second table would be
  /// unnecessary complexity for this milestone's actual needs.
  coverageAmount       Decimal? @db.Decimal(12, 2)
  coverageCurrencyCode String?

  /// S3 evidence for this credential (a licence scan, Certificate of
  /// Currency, ...) — same presign-PUT/GET pattern as
  /// MaintenanceRequestAttachment, reusing src/lib/s3.ts directly rather
  /// than a second storage mechanism. Nullable: a credential can be
  /// recorded (e.g. while chasing the contractor for evidence) before a
  /// document exists.
  documentStorageKey  String?
  documentFileName    String?
  documentContentType String?
  documentFileSize    Int?

  verificationStatus CredentialVerificationStatus  @default(PENDING)
  verificationSource CredentialVerificationSource?
  verifiedAt         DateTime?
  verifiedByUserId   String?

  /// Set the first (and only) time the expiry-notification scheduler
  /// notifies org staff that this credential has reached that state —
  /// never re-notified for the same expiry cycle. Reset to null whenever
  /// expiresAt materially changes (see ContractorCredentialsService.update),
  /// so a renewed credential's next real expiry notifies again.
  expiringSoonNotifiedAt DateTime?
  expiredNotifiedAt      DateTime?

  /// Free-text note from whoever last touched verification/rejection, or
  /// from whoever added the credential — never a substitute for the
  /// structured status fields above.
  notes String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id])
  contractor     Contractor   @relation(fields: [contractorId], references: [id])
  verifiedByUser User?        @relation("ContractorCredentialVerifiedBy", fields: [verifiedByUserId], references: [id])
  createdByUser  User         @relation("ContractorCredentialCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organisationId])
  @@index([contractorId])
  @@index([contractorId, category])
  @@index([expiresAt])
  @@map("contractor_credentials")
}

enum ComplianceEnforcement {
  BLOCK_ASSIGNMENT
  WARN_ONLY
}

/// What credential an organisation requires (or merely recommends) for a
/// given trade/work category, configured by that organisation alone —
/// Organisation Settings -> Contractor Compliance, OWNER/ADMIN only.
/// Deliberately a plain relational row per (organisation, category,
/// credentialType), never a JSON rule blob — every field here is something
/// ContractorEligibilityService explicitly understands and evaluates, not
/// an opaque configuration the backend merely stores.
model ContractorComplianceRequirement {
  id             String @id @default(cuid())
  organisationId String

  /// The trade/work category this requirement applies to (see
  /// Contractor.tradeCategories's doc comment for why this reuses
  /// MaintenanceCategory rather than a separate trade taxonomy).
  category           MaintenanceCategory
  credentialCategory CredentialCategory
  /// Matched case-insensitively against ContractorCredential.type.
  credentialType     String

  /// false = shown to admins/managers as a recognised-but-optional
  /// credential (e.g. "Professional Indemnity") that never blocks or warns
  /// on its own — informational only. true = participates in eligibility
  /// per `enforcement` below.
  required    Boolean               @default(true)
  /// Only consulted when required = true.
  enforcement ComplianceEnforcement @default(BLOCK_ASSIGNMENT)

  /// If true (the default), a credential that is merely PROVIDED but not
  /// yet reviewed (PENDING) does not satisfy this requirement. If false, a
  /// PENDING credential is accepted as sufficient.
  mustBeVerified   Boolean @default(true)
  /// If true (the default), an expired matching credential fails this
  /// requirement. Modelled explicitly (not assumed) since some credentials
  /// legitimately never expire.
  mustNotBeExpired Boolean @default(true)

  /// Only meaningful when credentialCategory = INSURANCE; null otherwise.
  minimumCoverageAmount       Decimal? @db.Decimal(12, 2)
  minimumCoverageCurrencyCode String?

  notes String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation  Organisation @relation(fields: [organisationId], references: [id])
  createdByUser User         @relation(fields: [createdByUserId], references: [id])

  @@unique([organisationId, category, credentialType])
  @@index([organisationId])
  @@index([organisationId, category])
  @@map("contractor_compliance_requirements")
}

// --- Contractor quotes + configurable WaslSign workflow (M8 / M9-A) ---

/// Approval and signature are tracked as two separate, independently
/// nullable statuses — never collapsed into one "approved" flag. Which of
/// them apply (if either) is entirely determined by `workflowMode`. See
/// docs on WorkflowMode below; the overall pass/fail result for a quote is
/// *derived* from (workflowMode, approvalStatus, signatureStatus) in
/// application code rather than stored redundantly here.
model ContractorQuote {
  id             String  @id @default(cuid())
  organisationId String
  /// Nullable since M11 — a quote exists from the moment a contractor is
  /// invited to a QuoteRound, long before any Work Order does. Set exactly
  /// once, at award time, when WorkOrdersService.authoriseFromQuote creates
  /// (or, for legacy Direct Work, already has) the Work Order this quote's
  /// commercial terms govern. Still required and set at creation for the
  /// pre-M11 Direct Work path, where a Work Order always already exists.
  workOrderId    String?
  /// Set only for a quote that originated from an M11 QuoteRound invitation
  /// — null for a Direct Work quote recorded straight against a Work Order,
  /// exactly as before this milestone.
  quoteRoundId   String?
  contractorId   String

  /// Nullable — a freshly-invited quote has no amount until the contractor
  /// (or a manager recording on their behalf) actually responds.
  amount       Decimal? @db.Decimal(10, 2)
  /// Copied from Organisation.currencyCode at creation (or an explicit
  /// override — a contractor may quote in a different currency) — never
  /// re-derived from the organisation setting, so changing the org default
  /// later never mutates an existing quote's own currency.
  currencyCode String   @default("AUD")
  description  String?

  status ContractorQuoteStatus @default(REQUESTED)
  /// How this quote's commercial content actually arrived — the contractor
  /// responding through their own secure link, or a manager typing up
  /// something received by phone/email/WhatsApp/PDF. Both participate in
  /// exactly the same comparison/selection/approval flow; this is purely
  /// informational provenance.
  source ContractorQuoteSource @default(MANUAL)

  /// Free text throughout — a contractor's own commercial offer doesn't fit
  /// a rigid structured shape, and forcing one invites either data loss or
  /// meaningless required fields.
  proposedStartAt   DateTime?
  estimatedDuration String?
  inclusions        String?
  exclusions        String?
  warrantyInfo      String?

  submittedAt DateTime?
  /// The contractor explicitly declined to quote (RFQ path only).
  declinedAt  DateTime?
  /// The contractor withdrew a SUBMITTED quote before it was selected.
  withdrawnAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  /// The human award decision — captured independently of the later
  /// approval/signature workflow, which only ever starts on the quote a
  /// manager has already chosen here. Never inferred from "lowest amount".
  selectedAt       DateTime?
  selectedByUserId String?

  /// What Wasl Property asked WaslSign (or nothing) to execute for this
  /// quote. Null until a manager makes that choice.
  workflowMode WorkflowMode?

  /// The minimum workflow the organisation's Approval & Acceptance policy
  /// requires for this quote's amount — resolved exactly once, at the
  /// moment this quote became the "selected quote / proposed award" (Direct
  /// Work: at creation; RFQ: at award), via ApprovalPolicyService. Null
  /// means either no policy was configured/enabled at that moment, or the
  /// quote's currency didn't match the policy's currency — in both cases no
  /// floor is enforced and a manager must explicitly choose workflowMode.
  /// Immutable afterwards: a later change to the organisation's policy must
  /// never rewrite this historical decision (see ApprovalPolicyService's
  /// own doc comment).
  requiredWorkflowMode   WorkflowMode?
  /// Frozen explanation of the resolution above (matched rule's band,
  /// currency, human-readable reason) — see ApprovalPolicyResolution in
  /// approval-policy.service.ts. Kept as JSON, not a live FK to
  /// ApprovalPolicyRule, so a later rule edit/deletion never changes what
  /// this historical record says was required at the time.
  approvalPolicySnapshot Json?

  /// Native to Wasl Property — WaslSign has no approval primitive today
  /// (see docs/waslsign-integration.md). Populated only when workflowMode
  /// is APPROVAL_ONLY or APPROVAL_THEN_SIGNATURE.
  approvalStatus   ApprovalStatus?
  approvedByUserId String?

  /// Backed by a real WaslSign agreement. Populated only when workflowMode
  /// is SIGNATURE_ONLY or APPROVAL_THEN_SIGNATURE (and, for the latter,
  /// only once approval has actually passed).
  signatureStatus     SignatureStatus?
  signedAt            DateTime?
  waslSignAgreementId String?
  waslSignStatus      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id])
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])
  quoteRound     QuoteRound?  @relation("QuoteRoundQuotes", fields: [quoteRoundId], references: [id])
  contractor     Contractor   @relation(fields: [contractorId], references: [id])
  approvedByUser User?        @relation("ContractorQuoteApprovedBy", fields: [approvedByUserId], references: [id])
  selectedByUser User?        @relation("ContractorQuoteSelectedBy", fields: [selectedByUserId], references: [id])

  /// Reverse of WorkOrder.selectedQuoteId — the FK lives on WorkOrder, this
  /// side has none of its own.
  awardedForWorkOrder  WorkOrder?                  @relation("WorkOrderSelectedQuote")
  /// Reverse of QuoteRound.awardedQuoteId — set only on the one quote a
  /// round was actually awarded to.
  awardedForQuoteRound QuoteRound?                 @relation("QuoteRoundAwardedQuote")
  /// Reverse of QuoteRoundInvitation.quoteId — set only for an RFQ-originated quote.
  invitation           QuoteRoundInvitation?
  attachments          ContractorQuoteAttachment[]

  @@index([organisationId])
  @@index([workOrderId])
  @@index([quoteRoundId])
  @@index([contractorId])
  @@index([waslSignAgreementId])
  @@map("contractor_quotes")
}

enum ContractorQuoteStatus {
  REQUESTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  /// The contractor explicitly declined the RFQ invitation.
  DECLINED
  /// The contractor withdrew a SUBMITTED quote before it was selected.
  WITHDRAWN
  /// The QuoteRound this quote belonged to was awarded to a different
  /// contractor — this quote was never wrong, just not chosen.
  NOT_SELECTED
}

/// How a ContractorQuote's commercial content actually arrived.
enum ContractorQuoteSource {
  MANUAL
  CONTRACTOR_PORTAL
}

/// What Wasl Property asks WaslSign to execute for one quote/work order.
/// Deliberately never forces both approval and signature — a business
/// process picks exactly the shape it needs.
enum WorkflowMode {
  NONE
  APPROVAL_ONLY
  SIGNATURE_ONLY
  APPROVAL_THEN_SIGNATURE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SignatureStatus {
  PENDING
  PARTIALLY_SIGNED
  SIGNED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Idempotency ledger for inbound WaslSign webhook callbacks — a duplicate
/// delivery of the same eventId is a guaranteed no-op. Deliberately holds no
/// organisationId: the callback payload's sourceEntityId is what gets
/// cross-checked against the target ContractorQuote's own organisationId at
/// handling time (see waslsign.service.ts), not this ledger.
model WaslSignWebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  receivedAt DateTime @default(now())
  payload    Json

  @@map("waslsign_webhook_events")
}

// --- Organisation Approval & Acceptance Policy (M12) ---

/// The organisation-owned business rule that decides whether a selected
/// quote / Direct Work commercial commitment / variation requires Approval
/// & Acceptance, and if so which workflow — replacing what used to be a
/// single hard-coded env var pair (WORK_ORDER_WASLSIGN_THRESHOLD_AED /
/// WORK_ORDER_DEFAULT_WORKFLOW_MODE). One per organisation (never per
/// property/category in this milestone — see ApprovalPolicyService's doc
/// comment for how the resolver is still shaped to add those dimensions
/// later without a rewrite). OWNER/ADMIN only, at the route level — same
/// bar as Roles & Permissions and Contractor Compliance configuration.
model OrganisationApprovalPolicy {
  id             String @id @default(cuid())
  organisationId String @unique

  /// The currency this policy's rule amount bands are expressed in — always
  /// captured explicitly (from the organisation's own currencyCode at
  /// save time) rather than re-derived live, so a later change to the
  /// organisation's default currency can never silently reinterpret
  /// already-configured amount bands in a different currency. See
  /// ApprovalPolicyService for the currency-mismatch handling this enables.
  currencyCode String

  /// false = the organisation has rules configured but has switched the
  /// whole policy off (e.g. temporarily) — treated identically to "not
  /// configured" by the resolver (no floor enforced, manager must choose
  /// explicitly), but the rules themselves are preserved so re-enabling
  /// doesn't require re-entering them.
  enabled Boolean @default(true)

  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation  Organisation         @relation(fields: [organisationId], references: [id])
  createdBy     User                 @relation("ApprovalPolicyCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser User?                @relation("ApprovalPolicyUpdatedBy", fields: [updatedByUserId], references: [id])
  rules         ApprovalPolicyRule[]

  @@map("organisation_approval_policies")
}

/// One contiguous amount band within an OrganisationApprovalPolicy — see
/// ApprovalPolicyService for the validation that guarantees, once a policy
/// has at least one rule, every non-negative amount matches exactly one
/// band (bands are contiguous and non-overlapping by construction: the
/// lowest rule's minAmount is 0, the highest rule's maxAmount is null/
/// open-ended, and every rule in between has minAmount == the previous
/// rule's maxAmount + 0.01).
model ApprovalPolicyRule {
  id             String @id @default(cuid())
  organisationId String
  policyId       String

  /// Inclusive lower bound, in the policy's currencyCode.
  minAmount Decimal  @db.Decimal(12, 2)
  /// Inclusive upper bound; null = open-ended ("above X") — exactly one
  /// rule per policy may have this null, and it must be the highest band.
  maxAmount Decimal? @db.Decimal(12, 2)

  workflowMode WorkflowMode

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation               @relation(fields: [organisationId], references: [id])
  policy       OrganisationApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([policyId])
  @@map("approval_policy_rules")
}

// --- Quote Management, Procurement & Variations (M11) ---

/// How a Maintenance Request's work is being arranged — chosen once, up
/// front, so the UI (and, more importantly, the backend) never treats a
/// contractor merely invited to quote as already selected for the work.
/// EMERGENCY_WORK is represented cleanly but carries no special backend
/// behaviour of its own in this milestone — no invented statutory
/// thresholds or delegated-authority rules; it exists so a future
/// organisation-level policy has somewhere real to hang off.
enum ProcurementPath {
  REQUEST_QUOTES
  DIRECT_WORK
  EMERGENCY_WORK
}

enum QuoteRoundStatus {
  /// Scope defined but no invitations sent yet — reserved for a future
  /// "save before sending" flow; today's UI always creates a round already
  /// OPEN.
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  AWARDED
}

/// A Request for Quote — the common Scope of Works a manager defines once
/// and issues to every invited contractor. Scope fields are a deliberate
/// snapshot of the originating MaintenanceRequest at the moment quoting
/// began: if the request is edited afterwards, every quote already
/// requested against this round must keep describing the scope contractors
/// actually saw, never silently changing under them.
model QuoteRound {
  id                   String  @id @default(cuid())
  /// See Property.publicReference's doc comment — "RFQ" prefix.
  publicReference      String  @unique
  organisationId       String
  propertyId           String
  spaceId              String?
  maintenanceRequestId String

  category           MaintenanceCategory
  title              String
  scopeDescription   String
  priority           MaintenancePriority
  accessInstructions String?
  desiredStartAt     DateTime?
  dueAt              DateTime?
  /// Snapshot of the organisation's currency at creation — never
  /// re-derived, exactly like every other financial record in this schema.
  currencyCode       String

  status      QuoteRoundStatus @default(OPEN)
  cancelledAt DateTime?

  /// The single quote this round was awarded to, once a manager selects a
  /// winner and it clears re-evaluated compliance — see
  /// QuoteRoundsService.award. Null while OPEN/CLOSED/CANCELLED.
  awardedQuoteId String?   @unique
  awardedAt      DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation       Organisation       @relation(fields: [organisationId], references: [id])
  property           Property           @relation(fields: [propertyId], references: [id])
  space              Space?             @relation(fields: [spaceId], references: [id])
  maintenanceRequest MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  createdBy          User               @relation("QuoteRoundCreatedBy", fields: [createdByUserId], references: [id])
  awardedQuote       ContractorQuote?   @relation("QuoteRoundAwardedQuote", fields: [awardedQuoteId], references: [id])

  invitations QuoteRoundInvitation[]
  quotes      ContractorQuote[]      @relation("QuoteRoundQuotes")
  workOrders  WorkOrder[]

  @@index([organisationId])
  @@index([propertyId])
  @@index([maintenanceRequestId])
  @@map("quote_rounds")
}

/// One contractor's invitation into a QuoteRound. Deliberately carries no
/// status of its own — its lifecycle is entirely the linked
/// ContractorQuote's status (REQUESTED = invited/awaiting, SUBMITTED =
/// responded, DECLINED/WITHDRAWN/EXPIRED = as named), so there is exactly
/// one state machine to reason about, never two that could drift apart.
/// "Viewed" is deliberately not modelled — there is no reliable read-receipt
/// signal to back it with.
model QuoteRoundInvitation {
  id             String @id @default(cuid())
  organisationId String
  quoteRoundId   String
  contractorId   String
  /// The ContractorQuote created alongside this invitation — 1:1, created
  /// in the same transaction.
  quoteId        String @unique

  /// Only the sha256 hash is ever persisted — the raw token exists only in
  /// the RFQ notification/link, exactly mirroring ContactInvite's own
  /// token handling.
  tokenHash      String    @unique
  tokenExpiresAt DateTime
  revokedAt      DateTime?

  invitedByUserId String
  createdAt       DateTime @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  quoteRound   QuoteRound      @relation(fields: [quoteRoundId], references: [id])
  contractor   Contractor      @relation(fields: [contractorId], references: [id])
  quote        ContractorQuote @relation(fields: [quoteId], references: [id])
  invitedBy    User            @relation("QuoteRoundInvitationInvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([quoteRoundId, contractorId])
  @@index([organisationId])
  @@index([quoteRoundId])
  @@index([contractorId])
  @@map("quote_round_invitations")
}

/// A contractor's own quote document (PDF, photos of a handwritten quote,
/// etc.) — distinct from the RFQ's own scope attachments (which are simply
/// the originating MaintenanceRequest's existing attachments, never
/// copied). Mirrors MaintenanceRequestAttachment exactly: bytes live in S3,
/// only metadata + storage key live here, storageKey is never exposed to
/// the frontend directly.
model ContractorQuoteAttachment {
  id                String  @id @default(cuid())
  organisationId    String
  contractorQuoteId String
  uploadedByUserId  String?

  storageKey  String
  fileName    String
  contentType String
  fileSize    Int

  createdAt DateTime @default(now())

  organisation    Organisation    @relation(fields: [organisationId], references: [id])
  contractorQuote ContractorQuote @relation(fields: [contractorQuoteId], references: [id])
  uploadedBy      User?           @relation(fields: [uploadedByUserId], references: [id])

  @@index([organisationId])
  @@index([contractorQuoteId])
  @@map("contractor_quote_attachments")
}

enum WorkOrderVariationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// Additional scope/cost discovered once work is already authorised — never
/// mutates the original selected quote (that stays immutable historical
/// evidence); the authorised total is always original amount + APPROVED
/// variations only, computed at read time, never stored.
model WorkOrderVariation {
  id              String @id @default(cuid())
  /// See Property.publicReference's doc comment — "VAR" prefix. Display/AI
  /// reference only today; no standalone customer-facing route exists for
  /// a variation (always shown nested inside its Work Order).
  publicReference String @unique
  organisationId  String
  workOrderId     String

  description  String
  amountDelta  Decimal @db.Decimal(10, 2)
  /// Always the Work Order's own currencyCode at creation — a variation can
  /// never introduce a second currency into one Work Order's commercial
  /// picture.
  currencyCode String

  status WorkOrderVariationStatus @default(PENDING_APPROVAL)

  /// Resolved once at creation via the same ApprovalPolicyService used for
  /// quotes, evaluating the variation amount itself (not the resulting
  /// authorised total — see the M12 Approval Policy milestone's final
  /// report for why). Immutable afterwards — a later organisation policy
  /// change never rewrites an already-created variation's requirement (see
  /// ContractorQuote.requiredWorkflowMode's identical doc comment).
  requiredWorkflowMode   WorkflowMode?
  approvalPolicySnapshot Json?

  /// The manager's actual confirmed choice — starts as the policy's
  /// suggestion (mirroring ContractorQuote.workflowMode exactly) but
  /// nothing in the approval/signature machinery below acts on it until
  /// explicitly confirmed via setWorkflowMode. Enforcement gap closed: a
  /// variation can now only reach APPROVED once every gate this implies
  /// has actually completed — see WorkOrderVariationsService.approve /
  /// handleWaslSignCallback.
  workflowMode        WorkflowMode?
  approvalStatus      ApprovalStatus?
  signatureStatus     SignatureStatus?
  signedAt            DateTime?
  /// Populated only once a SIGNATURE_ONLY / APPROVAL_THEN_SIGNATURE
  /// signature workflow has actually been started — same WaslSign
  /// integration ContractorQuote uses, never a second implementation.
  waslSignAgreementId String?
  waslSignStatus      String?

  recordedByUserId String
  approvedByUserId String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation                   @relation(fields: [organisationId], references: [id])
  workOrder      WorkOrder                      @relation(fields: [workOrderId], references: [id])
  recordedBy     User                           @relation("WorkOrderVariationRecordedBy", fields: [recordedByUserId], references: [id])
  approvedByUser User?                          @relation("WorkOrderVariationApprovedBy", fields: [approvedByUserId], references: [id])
  attachments    WorkOrderVariationAttachment[]

  @@index([organisationId])
  @@index([workOrderId])
  @@index([waslSignAgreementId])
  @@map("work_order_variations")
}

model WorkOrderVariationAttachment {
  id                   String  @id @default(cuid())
  organisationId       String
  workOrderVariationId String
  uploadedByUserId     String?

  storageKey  String
  fileName    String
  contentType String
  fileSize    Int

  createdAt DateTime @default(now())

  organisation       Organisation       @relation(fields: [organisationId], references: [id])
  workOrderVariation WorkOrderVariation @relation(fields: [workOrderVariationId], references: [id])
  uploadedBy         User?              @relation(fields: [uploadedByUserId], references: [id])

  @@index([organisationId])
  @@index([workOrderVariationId])
  @@map("work_order_variation_attachments")
}

// --- Communications & Notifications (M10) ---

enum CommunicationStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

/// Extensible on purpose: WHATSAPP exists here so the domain never needs a
/// redesign when a provider is configured, but only IN_APP and EMAIL are
/// actually implemented in M10 — WHATSAPP must never be offered as a
/// selectable channel in the UI until it is genuinely configured.
enum CommunicationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  FAILED
}

/// A manager-authored announcement to owners/tenants/residents. Immutable
/// once SENT — title/body are never edited after sending, only ever
/// duplicated into a new draft. See CommunicationRecipient and
/// CommunicationDelivery for the per-recipient, per-channel audit trail
/// captured at send time.
model Communication {
  id              String                 @id @default(cuid())
  /// See Property.publicReference's doc comment — "COM" prefix.
  publicReference String                 @unique
  organisationId  String
  title           String
  body            String
  status          CommunicationStatus    @default(DRAFT)
  channels        CommunicationChannel[]

  /// Structured targeting rule, not a frozen recipient list — e.g.
  /// {"scope":"PROPERTY","propertyIds":[...],"roles":[...],"includeContactIds":[...]}.
  /// Always re-resolved against current active memberships, including when
  /// reused via savedAudienceId, so a saved group never goes stale.
  audienceCriteria Json

  savedAudienceId String?

  createdByUserId String
  scheduledAt     DateTime?
  sentAt          DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation  Organisation             @relation(fields: [organisationId], references: [id])
  createdBy     User                     @relation(fields: [createdByUserId], references: [id])
  savedAudience SavedAudience?           @relation(fields: [savedAudienceId], references: [id])
  recipients    CommunicationRecipient[]

  @@index([organisationId, status])
  @@index([organisationId, scheduledAt])
  @@map("communications")
}

/// One row per resolved contact for a communication — the audit snapshot of
/// who this was actually addressed to at send time. Per-channel delivery
/// state hangs off this (CommunicationDelivery), not off Communication
/// directly, so a recipient can have independent delivery outcomes per
/// channel.
model CommunicationRecipient {
  id              String   @id @default(cuid())
  communicationId String
  contactId       String
  userId          String?
  propertyId      String?
  spaceId         String?
  createdAt       DateTime @default(now())

  communication Communication           @relation(fields: [communicationId], references: [id])
  contact       PropertyContact         @relation(fields: [contactId], references: [id])
  deliveries    CommunicationDelivery[]

  @@unique([communicationId, contactId])
  @@index([communicationId])
  @@index([contactId])
  @@index([userId])
  /// Backs get_communication_timeline's `WHERE propertyId = ? AND
  /// communication...` lookup (src/modules/ai/tools/tools.ts) — without
  /// it, every call scans the full table rather than one property's rows.
  @@index([propertyId])
  @@map("communication_recipients")
}

/// One row per (recipient, channel) — independently retryable and
/// idempotent (the unique constraint below means a retried send attempt
/// updates the same row rather than creating a duplicate). Provider-specific
/// state lives here so a future WhatsApp/SMS provider slots in without
/// touching Communication or CommunicationRecipient.
model CommunicationDelivery {
  id                       String               @id @default(cuid())
  communicationRecipientId String
  channel                  CommunicationChannel
  status                   DeliveryStatus       @default(PENDING)

  providerMessageId String?
  attemptedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communicationRecipient CommunicationRecipient @relation(fields: [communicationRecipientId], references: [id])

  @@unique([communicationRecipientId, channel])
  @@index([status])
  @@map("communication_deliveries")
}

/// A reusable audience rule. Stores criteria (the same shape as
/// Communication.audienceCriteria), not a frozen list of contacts, so it
/// always resolves against current active memberships when used.
model SavedAudience {
  id              String   @id @default(cuid())
  organisationId  String
  name            String
  criteria        Json
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  createdBy      User            @relation(fields: [createdByUserId], references: [id])
  communications Communication[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("saved_audiences")
}

/// The unified in-app inbox row for a user — sourced either from a sent
/// Communication (manager announcement) or directly from a system event
/// (maintenance/work-order/quote/membership changes). One table, one
/// unread-count query, one bell, regardless of origin. sourceCommunicationId
/// / sourceActivityEventId are plain reference ids (not enforced relations),
/// same pattern as WaslSignWebhookEvent above — the notification already
/// carries its own title/body/entityType/entityId, so it never depends on
/// the source row still existing to render correctly.
model Notification {
  id             String @id @default(cuid())
  organisationId String
  userId         String

  title String
  body  String?

  /// Mirrors ActivityEvent's entityType/entityId convention so a
  /// notification can link through to the real record. Normal API
  /// authorization always still applies when that link is opened —
  /// possession of a notification is never itself authorization.
  entityType String?
  entityId   String?

  sourceCommunicationId String?
  sourceActivityEventId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organisationId, userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// --- Wasl AI (M14) ---
//
// Deliberately channel-agnostic even though only WEB is active today — see
// src/modules/ai/ai.types.ts and the M14 final report's "Channel-Agnostic
// Architecture" section. WHATSAPP/MOBILE/API are reserved enum values with
// no adapter behind them yet; adding one must never require a schema
// change here.

enum AiChannel {
  WEB
  WHATSAPP
  MOBILE
  API
}

enum AiMessageRole {
  USER
  ASSISTANT
}

/// One conversation thread. A WhatsApp phone number (or any other
/// channel-native identity) is never itself the WaslProp identity — every
/// row here already carries a resolved userId, meaning identity
/// verification/linking to a real User happened upstream of this model,
/// never inside it. See externalConversationRef's own doc comment.
model AiConversation {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  channel        AiChannel @default(WEB)

  /// Opaque external thread identity for a non-WEB channel (e.g. a
  /// WhatsApp conversation id) — carried for routing only, never consulted
  /// for authorization or identity. Null for WEB, where the session token
  /// already is the identity.
  externalConversationRef String?

  /// The resource (if any) this conversation was opened scoped to — e.g.
  /// "Investigate with Wasl AI" from a Maintenance Request. Carried so
  /// follow-up turns keep the same investigation context without the
  /// frontend resending it every message. Independent of channel — a
  /// future WhatsApp reply to a notification about the same resource could
  /// attach identical context.
  contextResourceType String?
  contextResourceId   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastActiveAt DateTime @default(now())

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  messages     AiMessage[]
  auditEvents  AiAuditEvent[]

  @@index([organisationId, userId, lastActiveAt])
  @@map("ai_conversations")
}

/// A single turn. Deliberately bounded/shallow — only the user's message
/// and the assistant's final answer are persisted, never the intermediate
/// tool-call exchange or any chain-of-thought (see AiOrchestrator). A
/// USER row's structuredResponse is always null.
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String

  /// The channel-neutral AiResponse (sections/findings/resources/
  /// suggestedActions) for an ASSISTANT message — null for USER. WEB
  /// renders this richly; a future channel renders a reduced form from the
  /// same evidence, never a separately-generated answer.
  structuredResponse Json?

  createdAt DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Every AI turn's audit trail — deliberately metadata-only. Never a full
/// payload dump, never chain-of-thought, never secrets: see
/// src/modules/ai/audit/ai-audit.service.ts's own doc comment for exactly
/// what is and isn't written here.
model AiAuditEvent {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  conversationId String?
  channel        AiChannel
  provider       String
  model          String

  /// Tool names invoked this turn, in call order — never arguments or
  /// results.
  toolNames String[]

  targetResourceType String?
  targetResourceId   String?

  success   Boolean
  latencyMs Int

  inputTokens  Int?
  outputTokens Int?

  /// Set only when a guardrail actually fired this turn — e.g.
  /// "BUDGET_EXCEEDED", "UNKNOWN_TOOL_REJECTED", "RATE_LIMITED",
  /// "MALFORMED_RESPONSE". Null on an unremarkable successful turn.
  guardrailEvent String?
  errorCode      String?

  createdAt DateTime @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  conversation AiConversation? @relation(fields: [conversationId], references: [id])

  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_audit_events")
}

// --- Property Document Intelligence (M15) ---
//
// A reusable foundation, not an NSW-strata-specific model: PropertyDocument
// is deliberately generic (any future document type — other states' strata
// plans, insurance certificates, management agreements — reuses this same
// model, see PropertyDocumentType). DocumentAnalysis is append-only: each
// row is one analysis ATTEMPT (never mutated afterward, never deleted),
// so a document can be reprocessed later with an improved extractor
// without destroying the history of what an earlier attempt found — see
// the M15 final report's "reprocessing foundation" section. Authoritative
// Property/Space/UOE data is never written by anything in this section —
// only PropertyDocumentOnboardingService.confirm (see property-documents
// module) ever creates those, and only from PropertyDocument.draft after
// explicit user confirmation.

/// Extensible document-type catalogue — the ONLY type implemented in M15
/// is NSW_STRATA_PLAN. A future document type is added here, never
/// inferred from a filename/extension (see classification.ts's own doc
/// comment).
enum PropertyDocumentType {
  NSW_STRATA_PLAN
}

/// The document's own lifecycle — what the frontend polls while waiting
/// for analysis, and what an upload/review screen branches on.
/// REVIEW_REQUIRED and READY both land on the same human review screen;
/// READY only means the latest analysis produced zero blocking issues to
/// start with. Neither is reachable until an analysis attempt has
/// actually completed (see DocumentAnalysisStatus below).
enum PropertyDocumentStatus {
  UPLOADED
  ANALYSING
  REVIEW_REQUIRED
  READY
  FAILED
  CONFIRMED
}

/// One uploaded source document — the durable object everything else
/// hangs off. Storage bytes live in S3 (see lib/s3.ts); this row is only
/// ever metadata + a storage key, mirroring MaintenanceRequestAttachment.
model PropertyDocument {
  id               String @id @default(cuid())
  organisationId   String
  uploadedByUserId String

  /// Null until classification actually runs — see DocumentAnalysis.
  documentType PropertyDocumentType?
  status       PropertyDocumentStatus @default(UPLOADED)

  storageKey  String
  fileName    String
  contentType String
  fileSize    Int
  pageCount   Int?

  /// The CURRENT editable review state — property fields + lots[] — seeded
  /// from the latest successful DocumentAnalysis.extraction once analysis
  /// completes, then mutated in place via the review screen's correction
  /// endpoint (never triggers re-analysis; see StrataPlanDraft in
  /// property-documents/nsw-strata-plan/draft.types.ts). Null until an
  /// analysis has produced a usable draft.
  draft Json?

  /// Set exactly once, at confirmation — the one field that makes
  /// confirmation idempotent (see PropertyDocumentOnboardingService.confirm:
  /// a second confirm attempt on an already-confirmed document returns
  /// this property rather than creating a duplicate). Never set any other
  /// way.
  createdPropertyId String?   @unique
  confirmedByUserId String?
  confirmedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation    Organisation       @relation(fields: [organisationId], references: [id])
  uploadedBy      User               @relation("PropertyDocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  confirmedBy     User?              @relation("PropertyDocumentConfirmedBy", fields: [confirmedByUserId], references: [id])
  createdProperty Property?          @relation(fields: [createdPropertyId], references: [id])
  analyses        DocumentAnalysis[]

  @@index([organisationId, createdAt])
  @@map("property_documents")
}

enum DocumentAnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// One analysis ATTEMPT — append-only, never mutated after it finishes.
/// `extraction` is the frozen, provenance-wrapped structured output (see
/// StrataPlanExtraction) exactly as the extractor/AI produced it; it is
/// never edited — user corrections live on PropertyDocument.draft instead,
/// so "what did the document originally say" and "what did the user
/// confirm" are always both recoverable (M15 Section 30).
model DocumentAnalysis {
  id                 String @id @default(cuid())
  organisationId     String
  propertyDocumentId String

  status DocumentAnalysisStatus @default(PENDING)

  /// Classification outcome for this attempt — recorded even when below
  /// the confidence bar required to proceed, so a rejected attempt still
  /// leaves an audit trail of what was tried and why it was rejected.
  classifiedDocumentType   PropertyDocumentType?
  classificationConfidence Float?
  classificationEvidence   String?

  /// The full structured extraction tree (every business field wrapped as
  /// an ExtractedField<T> with confidence + source) — see
  /// property-documents/nsw-strata-plan/extraction.types.ts. Null until
  /// extraction actually runs/succeeds.
  extraction Json?
  /// ValidationIssue[] as computed deterministically against `extraction`
  /// at the moment analysis completed — a frozen snapshot for audit only;
  /// the live review screen always recomputes issues from the CURRENT
  /// PropertyDocument.draft instead (see Section 21: corrections must
  /// revalidate without re-running AI).
  issues     Json?

  /// Which provider/model/extractor actually produced this attempt — kept
  /// for the "reprocessing foundation" requirement; never silently
  /// overwritten by a later attempt (each attempt is its own row).
  extractionProvider String?
  extractionModel    String?
  ocrEngine          String?

  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  organisation     Organisation     @relation(fields: [organisationId], references: [id])
  propertyDocument PropertyDocument @relation(fields: [propertyDocumentId], references: [id])

  @@index([organisationId])
  @@index([propertyDocumentId, createdAt])
  @@map("document_analyses")
}
