NODE_ENV=test
EMAIL_SEND_DISABLED=true
PORT=4101

DATABASE_URL=postgresql://hamza.tariq@localhost:5432/wasl_property_test?schema=public

JWT_ACCESS_SECRET=test_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_refresh_secret
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:5174

LOG_LEVEL=silent

INVITE_TOKEN_EXPIRES_IN_HOURS=72
AWS_REGION=me-central-1
S3_BUCKET_NAME=wasl-property-uploads-test
MAINTENANCE_ATTACHMENT_MAX_FILES=5
MAINTENANCE_ATTACHMENT_MAX_SIZE_MB=10
SMTP_FROM=Wasl Property <no-reply@waslproperty.dev>
# Explicitly pinned empty/blank here (never left unset) so that
# src/config/env.ts's later `import 'dotenv/config'` — which loads the
# default .env and only fills in keys that are NOT already present in
# process.env — can never backfill the real SMTP/Resend credentials from
# .env into the test process. Leaving any of these absent from this file
# is what caused test runs to send real email through the real Gmail
# account configured in .env. Do not remove these lines.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

WASLSIGN_WEBHOOK_SECRET=test-webhook-secret

# AI_ENABLED=true so the platform half of the AI kill switch is on for
# tests exercising the happy path — DeepSeekAiProvider is always mocked in
# tests (see test/integration/ai.test.ts), so this key is never actually
# sent over the network.
AI_ENABLED=true
DEEPSEEK_API_KEY=test-deepseek-key
