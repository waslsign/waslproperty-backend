NODE_ENV=development
PORT=4100

# Own PostgreSQL instance — never shared with WaslSign
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wasl_property

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
FRONTEND_URL=http://localhost:5174

LOG_LEVEL=debug

# Resident invitations (M6.5)
INVITE_TOKEN_EXPIRES_IN_HOURS=72

# S3 (M6.5) — maintenance request photo attachments. Credentials are picked
# up from the default AWS SDK credential chain (e.g. ~/.aws/credentials);
# only region + bucket are required here.
AWS_REGION=me-central-1
S3_BUCKET_NAME=wasl-property-uploads-dev
MAINTENANCE_ATTACHMENT_MAX_FILES=5
MAINTENANCE_ATTACHMENT_MAX_SIZE_MB=10

# SMTP (M6.5) — invitation emails. Leave SMTP_HOST unset in development to
# fall back to an ad-hoc Ethereal test inbox (preview URL is logged).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Wasl Property <no-reply@waslproperty.dev>

BACKEND_PUBLIC_URL=http://localhost:4100

# --- WaslSign integration (M9-A) ---
# Leave unset in an environment that shouldn't offer SIGNATURE_ONLY /
# APPROVAL_THEN_SIGNATURE workflows — WaslSignService treats that as
# "unavailable", not a startup failure. clientId/clientSecret come from
# waslsign-backend's scripts/create-service-client.ts; the webhook secret
# must exactly match that WaslSign deployment's own WASLSIGN_WEBHOOK_SECRET.
# WASLSIGN_API_BASE_URL=
# WASLSIGN_SERVICE_CLIENT_ID=
# WASLSIGN_SERVICE_CLIENT_SECRET=
# WASLSIGN_WEBHOOK_SECRET=

WORK_ORDER_WASLSIGN_THRESHOLD_AED=5000
WORK_ORDER_DEFAULT_WORKFLOW_MODE=APPROVAL_ONLY
