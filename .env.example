NODE_ENV=development
PORT=4100

# Own PostgreSQL instance — never shared with WaslSign
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wasl_property

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
FRONTEND_URL=http://localhost:5174

LOG_LEVEL=debug

# --- Reserved for future slices (not used yet) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=
# WASLSIGN_API_BASE_URL=
# WASLSIGN_SERVICE_CLIENT_ID=
# WASLSIGN_SERVICE_CLIENT_SECRET=
# WASLSIGN_WEBHOOK_SECRET=
